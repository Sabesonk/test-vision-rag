# ─────────────────────────────────────────────────────────────────────────────────────────────────
#  STUB / REPLAY — the free profile.  Switch with:   bash scripts/use-env.sh stub
# ─────────────────────────────────────────────────────────────────────────────────────────────────
#
# Nothing here can spend money. `VSIR_VLM=stub` is ONE switch that selects both the VLM backend
# (vsir/vlm/__init__.py BACKENDS) and the embedding backend (vsir/ingest/embed.py EMBEDDERS), so a
# run that replays S2 from a fixture cannot quietly buy embeddings either.
#
# KNOW WHAT YOU GET. The stub VLM replays REAL frozen responses, so summaries, topics and codes are
# genuine. The stub embedder has no frozen vectors to replay — it COMPUTES a blake2b hash of the
# composition. Those vectors are structureless: adjacent and distant pages score ~0.00 alike, and
# adding one character to a query rerolls the entire ranking. Replay mode is right for exercising
# the pipeline and WRONG for judging retrieval quality. Use the live profile for that.
#
# The dim differs from the live profile on purpose: the collection name carries it
# (`config.pages_collection`), so the two profiles address DIFFERENT collections and hash vectors
# can never be mixed into the real index by a forgotten export.

# ── Required ─────────────────────────────────────────────────────────────────────────────────────
VSIR_PORT=8000
# The dev stack maps Qdrant to 6353 on the host (docker-compose.yml), NOT 6333. Point a host-side
# CLI at 6353 or it writes into whatever unrelated Qdrant happens to hold 6333.
VSIR_QDRANT_URL=http://localhost:6353
VSIR_COLLECTION=vsir_pages
VSIR_VLM=stub
VSIR_VLM_MODEL=gemini-3.8-flash
VSIR_EMBED_MODEL=gemini-embedding-2
# The checked-in fixtures under data/fixtures/ were frozen under s2-v1 and replay keys on this
# value. Do not move it to s2-v2 here: every replay would miss by key.
VSIR_PROMPT_VERSION=s2-v1
# Placeholder, as in .env.example — a committed sample carries no real credential.
# `scripts/use-env.sh` copies your actual token across when it switches profiles.
VSIR_API_TOKENS=replace-with-a-platform-issued-token
VSIR_READ_QUOTA=50
# Belt and braces. `stub` already cannot spend; this keeps POST /documents refusing as well.
VSIR_ALLOW_PAID=0
VSIR_LOG_LEVEL=INFO
VSIR_RELEASE_ID=dev-0

# ── Optional ─────────────────────────────────────────────────────────────────────────────────────
# 1536 -> collection `vsir_pages_1536`, which is the pre-BM25, hash-vector index.
VSIR_EMBED_DIM=1536
VSIR_RUNS_COLLECTION=vsir_runs
VSIR_READS_PER_QUESTION=3
# Where frozen responses are replayed from. A miss is a typed `fixture_miss`, never a live call.
#   data/fixtures/synthetic_3window          the synthetic corpus (s2-v1)
#   data/fixtures/live/SICK-DETECTOR-BOX@3.0 the REAL 2026-09-11 paid ingest, frozen (s2-v2 —
#                                            needs VSIR_PROMPT_VERSION=s2-v2 to key correctly)
VSIR_FIXTURE=data/fixtures/synthetic_3window
VSIR_VLM_TIER=standard
VSIR_EMBED_TEXT_CHARS=2000
# Empty in the committed sample, but `scripts/use-env.sh` carries your real key across when it
# switches — otherwise stub -> live would drop the credential and the next live run would fail
# per call, after billing whatever it managed to send. Carrying it is safe: with VSIR_VLM=stub
# neither StubBackend nor StubEmbedder takes a credential, so there is no path that could use it.
VSIR_VLM_KEY=
