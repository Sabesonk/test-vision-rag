# ─────────────────────────────────────────────────────────────────────────────────────────────────
#  LIVE / PAID — the real profile.  Switch with:   bash scripts/use-env.sh live
# ─────────────────────────────────────────────────────────────────────────────────────────────────
#
#  ** EVERYTHING IN THIS PROFILE COSTS MONEY. **
#
#  An ingest bills: S1 facts once per document, S2 once per window (<=30 pages), and one embedding
#  per page. A SEARCH bills one query embedding. A `read` bills per unique read_key against
#  VSIR_READ_QUOTA. VSIR_ALLOW_PAID gates exactly one thing — POST /documents — and gates nothing
#  on the CLI: `vsir ingest --vlm gemini` spends regardless. There is no rate limiter on the
#  embedding side. The brake is the operator, not a switch.
#
# This is the profile that produced `vsir_pages_3072` on 2026-09-11: real gemini-embedding-2
# vectors at 3072 dims and BM25-weighted sparse surfaces.

# ── Required ─────────────────────────────────────────────────────────────────────────────────────
VSIR_PORT=8000
# 6353, not 6333 — see the note in .env.stub.example. Ingesting into the wrong Qdrant is a full
# re-bill to discover.
VSIR_QDRANT_URL=http://localhost:6353
VSIR_COLLECTION=vsir_pages
VSIR_VLM=gemini
VSIR_VLM_MODEL=gemini-3.8-flash
VSIR_EMBED_MODEL=gemini-embedding-2
# MANDATORY for any live run. PROMPT_DIGESTS (vsir/vlm/client.py) releases ONLY s2-v2; s2-v1 has no
# text behind it any more and `prompt()` refuses it by name at step 04 — after the run has started.
# s2-v2 is also what fixed the empty-`sections` defect an earlier live run shipped.
VSIR_PROMPT_VERSION=s2-v2
# Placeholder, as in .env.example — a committed sample carries no real credential.
# `scripts/use-env.sh` copies your actual token across when it switches profiles.
VSIR_API_TOKENS=replace-with-a-platform-issued-token
VSIR_READ_QUOTA=50
# 1 lets POST /documents accept an upload that bills. Set 0 to keep the HTTP upload route refusing
# `403 spend_not_permitted` while still ingesting deliberately from the CLI.
VSIR_ALLOW_PAID=1
VSIR_LOG_LEVEL=INFO
VSIR_RELEASE_ID=dev-0

# ── Optional ─────────────────────────────────────────────────────────────────────────────────────
# 3072 -> collection `vsir_pages_3072`: real vectors, BM25 sparse. Changing this is a new
# collection plus a full re-embed, never an in-place mix (§6.6).
VSIR_EMBED_DIM=3072
VSIR_RUNS_COLLECTION=vsir_runs
VSIR_READS_PER_QUESTION=3
# Empty for a live run. Pointing it at a directory holding an `expected.json` makes the CLI grade
# THIS document against THAT corpus's acceptance table and exit non-zero on a run that published
# perfectly. When recording, point --fixture at the same fresh --record directory.
VSIR_FIXTURE=
VSIR_VLM_TIER=standard
VSIR_EMBED_TEXT_CHARS=2000
# Required when VSIR_VLM=gemini. Deliberately EMPTY in this committed sample — a real key belongs
# in the platform secret store. `scripts/use-env.sh` carries the value across from your existing
# .env so switching profiles never loses it.
VSIR_VLM_KEY=
