# Config is the environment, and a real environment is never committed (§15 Factor III).
.env
.env.*
!.env.example
# The two profile samples ARE committed: they carry no secret (the key is empty and
# `scripts/use-env.sh` injects it from the .env you already had), and a profile nobody can read
# is a profile nobody switches to correctly.
!.env.stub.example
!.env.live.example

# Input documents. Generated fixtures are checked in explicitly (Spec §4.1).
data/source/*
!data/source/.gitkeep
# The M2a corpus is generated by `python -m vsir.eval.synthetic_pdf`, reproducible byte for byte,
# and every M2a assertion is anchored to its content hash — so it is committed, not gitignored.
!data/source/synthetic_3window.pdf
# The M8 corpus, on the same terms: `python -m vsir.eval.synthetic_large`, 150 pages and no
# contents page, which is what makes it plan at Level 2 and gives the resume test its five
# window checkpoints (§13 M8 — a generated large PDF, never the 1,440-page manual).
!data/source/synthetic_large.pdf

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.coverage

# Node / frontend (M7)
node_modules/
dist/
playwright-report/
test-results/

# Loop runner output
log/

# Claude Code local state: per-session settings and git worktrees (an embedded repository,
# which must never be committed into this one).
.claude/worktrees/

# The document store: the source PDFs `POST /documents` deposits, on the host rather than in a
# Docker-managed volume so an operator can see and replace them (`VSIR_DOCUMENTS_DIR`). Corpus
# data, not repository content — megabytes of it, one file per ingested revision, and the index
# is the source of truth for retrieval either way.
/var/

# macOS Finder metadata — never a repository artefact
.DS_Store
