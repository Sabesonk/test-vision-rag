# vsir configuration — the environment is the only source (Spec §15 Factor III).
#
# Copy to .env and load it into the shell before running the CLI:
#
#     cp .env.example .env && set -a && . ./.env && set +a
#
# The app itself never reads this file. Nothing here is a default baked into the code or the
# image: a deployment supplies these as environment variables, and secrets arrive from the
# platform secret store at runtime (§15.2 bans a committed config file and a secret in an image).
#
# Model ids and the prompt version are config *and* cache-key / collection-fingerprint inputs, so
# changing one is a release, not a hot edit (§6.3, §6.6, F11).

# ── Required. `vsir doctor` refuses to start and names the missing one (§4.3). ───────────────────
VSIR_PORT=8000
VSIR_QDRANT_URL=http://localhost:6333
VSIR_COLLECTION=vsir_pages
# gemini | stub. `stub` is how CI, the E2E suite and the console run the whole loop with no API
# key (D10) — selected by config, never by a code branch or a test-only import (§15 Factor X).
VSIR_VLM=stub
# The pinned id for Gemini 3.8 Flash (§4.2). Boot refuses any id ending in -latest (F11): the
# previous implementation ran `gemini-pro-latest` and warned in its own comment that model ids
# move. Confirm the exact dated suffix against Google's model list before the first paid run.
VSIR_VLM_MODEL=gemini-3.8-flash-001
# Gemini Embedding 2 — carried from impl/config.yaml. A change here is a new collection plus a
# full re-embed plus an alias swap, never an in-place mix (§6.6).
VSIR_EMBED_MODEL=gemini-embedding-2
VSIR_PROMPT_VERSION=s2-v1
# Comma-separated bearer tokens. Platform-issued; rotation needs no image rebuild. Never logged,
# never echoed in a response (§15.1).
VSIR_API_TOKENS=replace-with-a-platform-issued-token
VSIR_READ_QUOTA=50
VSIR_ALLOW_PAID=0
VSIR_LOG_LEVEL=INFO
# Immutable identity of image + config. Stamped on every run record and every response envelope,
# so any answer traces to the exact code and configuration that produced it (§15 Factor V).
VSIR_RELEASE_ID=dev-0

# ── Optional. Defaulted in code; the value shown is the default. ─────────────────────────────────
# 768 | 1536 | 3072 (MRL truncation). Carried in the collection name and the fingerprint (§6.6).
VSIR_EMBED_DIM=1536
# The D9 control plane: runs, windows and the observed-token inventory.
VSIR_RUNS_COLLECTION=vsir_runs
# The runner's hard ceiling per question, surfaced as reads_remaining (§8.4, F18).
VSIR_READS_PER_QUESTION=3
# Replay mode (D10): with VSIR_VLM=stub, frozen S2 and read responses are served from this
# directory by extract_key / read_key. A miss is a typed fixture_miss, never a live call.
VSIR_FIXTURE=
# standard | batch. Not an extract_key input — the tier does not change the response (§6.3).
VSIR_VLM_TIER=standard
# Where the checked-in synthetic corpus of §13 M1 is, for `vsir demo exact --synthetic` and the
# L2 acceptance suite. Empty means the repository copy at data/fixtures/synthetic_pages/. The
# Docker build context is backend/, so the fixture is NOT in the image: a container running the
# demo mounts it and points this at the mount, exactly as VSIR_FIXTURE does for replay mode (D10).
VSIR_SYNTHETIC_PAGES=
# Characters of page text carried into the dense composition (§5.3, D4).
VSIR_EMBED_TEXT_CHARS=2000
# The VLM credential. Required only when VSIR_VLM=gemini. Leave empty here — this file is an
# example, and a real value belongs in the platform secret store.
VSIR_VLM_KEY=
