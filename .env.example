# vsir configuration — the environment is the only source (Spec §15 Factor III).
#
# Copy to .env and load it into the shell before running the CLI:
#
#     cp .env.example .env && set -a && . ./.env && set +a
#
# The app itself never reads this file. Nothing here is a default baked into the code or the
# image: a deployment supplies these as environment variables, and secrets arrive from the
# platform secret store at runtime (§15.2 bans a committed config file and a secret in an image).
#
# Model ids and the prompt version are config *and* cache-key / collection-fingerprint inputs, so
# changing one is a release, not a hot edit (§6.3, §6.6, F11).

# ── Required. `vsir doctor` refuses to start and names the missing one (§4.3). ───────────────────
VSIR_PORT=8000
VSIR_QDRANT_URL=http://localhost:6333
VSIR_COLLECTION=vsir_pages
# gemini | stub. `stub` is how CI, the E2E suite and the console run the whole loop with no API
# key (D10) — selected by config, never by a code branch or a test-only import (§15 Factor X).
VSIR_VLM=stub
# The pinned id for Gemini 3.8 Flash (§4.2). Boot refuses any id ending in -latest (F11): the
# previous implementation ran `gemini-pro-latest` and warned in its own comment that model ids
# move. Confirm the exact dated suffix against Google's model list before the first paid run.
VSIR_VLM_MODEL=gemini-3.8-flash
# Gemini Embedding 2 — carried from impl/config.yaml. A change here is a new collection plus a
# full re-embed plus an alias swap, never an in-place mix (§6.6).
VSIR_EMBED_MODEL=gemini-embedding-2
# The frozen fixtures under data/fixtures/ were recorded with s2-v1, and replay
# keys on this value — so the default stays there. A LIVE run needs the released
# set (s2-v2); `scripts/stack.sh up --live` exports it for you.
VSIR_PROMPT_VERSION=s2-v1
# Comma-separated bearer tokens. Platform-issued; rotation needs no image rebuild. Never logged,
# never echoed in a response (§15.1). Every path but /health, /ready and /metrics needs one.
#
# A caller's identity is derived from its token — `caller-<sha256(token)[:12]>` — and that digest
# is what reaches the audit line and the budget ledger. There is no separate user list and no
# `X-User-Id` header: a caller who could name itself in the log that says who spent the money
# could name somebody else. Rotating a token therefore mints a new caller id, which is the honest
# behaviour; the map from digest to human lives with whoever issued the credential.
#
# **Replace this before anything works.** It is read by the CLI, by a direct `vsir serve` *and* by
# `docker-compose.yml` — one variable, so there is one answer to "which token?" on one machine.
# Leaving the placeholder is not a broken configuration, which is what makes it confusing: the
# string is a perfectly valid token, so a direct run accepts it while anything reading a different
# value 401s, and neither says why. `bash scripts/stack.sh status` prints the token the running
# container actually has, which is the one that works.
#
#   python3 -c "import secrets; print('vsir-dev-' + secrets.token_urlsafe(18))"
#
VSIR_API_TOKENS=replace-with-a-platform-issued-token
# Reads one caller may spend per UTC day, held as a `kind: budget` point in vsir_runs so N
# replicas enforce one ceiling (§7.3). Exhausting it is a 429, never a truncated result. Only
# `read` charges it; `reads_remaining` is on every envelope either way.
VSIR_READ_QUOTA=50
VSIR_ALLOW_PAID=0
VSIR_LOG_LEVEL=INFO
# Immutable identity of image + config. Stamped on every run record and every response envelope,
# so any answer traces to the exact code and configuration that produced it (§15 Factor V).
VSIR_RELEASE_ID=dev-0

# ── Optional. Defaulted in code; the value shown is the default. ─────────────────────────────────
# 768 | 1536 | 3072 (MRL truncation). Carried in the collection name and the fingerprint (§6.6).
VSIR_EMBED_DIM=1536
# The D9 control plane: runs, windows and the observed-token inventory.
VSIR_RUNS_COLLECTION=vsir_runs
# The runner's hard ceiling per question, surfaced as reads_remaining (§8.4, F18).
VSIR_READS_PER_QUESTION=3
# Replay mode (D10): with VSIR_VLM=stub, frozen S2 and read responses are served from this
# directory by extract_key / read_key. A miss is a typed fixture_miss, never a live call.
VSIR_FIXTURE=
# standard | batch. Not an extract_key input — the tier does not change the response (§6.3).
# Ingestion has no latency requirement, so a full-corpus run belongs on the Batch API (50% off);
# prompt tuning and a single-document ingest use the standard endpoint.
VSIR_VLM_TIER=standard
# Calls a minute the VLM client allows itself, as a token bucket. Deployment-varying because it is
# a property of the project's provider quota, not of the corpus. It bounds the burst, never the
# total: a full-corpus fan-out paces itself instead of firing every window at once and then
# serving out its own 429s (§6.3).
VSIR_VLM_RPM=60
# Where the checked-in synthetic corpus of §13 M1 is, for `vsir demo exact --synthetic` and the
# L2 acceptance suite. Empty means the repository copy at data/fixtures/synthetic_pages/. The
# Docker build context is backend/, so the fixture is NOT in the image: a container running the
# demo mounts it and points this at the mount, exactly as VSIR_FIXTURE does for replay mode (D10).
VSIR_SYNTHETIC_PAGES=
# Where the ported `impl` baseline of §12.1 is — the S2 responses, labels.jsonl and withheld.jsonl
# somebody already paid for, which the §12.3 PARITY and negative suites run against. Empty means
# the repository copy at data/fixtures/legacy/. Same reason as VSIR_SYNTHETIC_PAGES above: the
# fixture is not in the image, so a container running those suites mounts it and points this here.
VSIR_LEGACY_FIXTURE=
# Characters of page text carried into the dense composition (§5.3, D4).
VSIR_EMBED_TEXT_CHARS=2000
# The document store (§4.2): the mounted volume the SOURCE PDFs live on, one file per document as
# `<doc_id>@<revision>.pdf`. Empty means a directory under the platform temporary directory, which
# is honest about being ephemeral — a deployment that wants a page image to survive the container
# mounts a volume and names it here, and every process type of the release reads the same one.
#
# This is NOT a raster cache and it does not weaken §4.2: rasters are still never persisted, they
# are re-rendered on demand into an in-process LRU. What changed at U029 is that there is now
# something to re-render *from*. Ingestion deposits at step 02, `page_id` -> `doc_id@revision` ->
# bytes resolves it back, and a document that is not here is a typed `document_not_stored` naming
# the document — never a placeholder image and never a 500. `vsir documents` prints what it holds.
VSIR_DOC_STORE=
# Where that store lives **on the host**, for the compose stack only — the container always sees
# it at VSIR_DOC_STORE above. A host directory rather than a named volume so the ingested PDFs are
# somewhere a person can `ls`, drop a corrected file into, or back up: on macOS and Windows a
# named volume lives inside the Docker VM, so "where did my document go?" had no answer short of
# `docker cp`. Relative paths resolve against the repository root. Git-ignored, and
# `stack.sh down --wipe` empties it in the same breath as it drops the index — a wipe that took
# one and left the other would leave a store describing a corpus that is no longer indexed.
VSIR_DOCUMENTS_DIR=./var/documents
# The two sources `safety_flag` is computed from in the §6.8 export — comma-separated, both empty
# by default. VSIR_SAFETY_DOC_TYPES matches the manifest doc_type the uploader declared;
# VSIR_SAFETY_TOPICS matches the model's own lowercase topics[]. Configuration rather than a list
# in the image, because the vocabulary is the corpus's: impl hardcoded the keywords and no
# deployment could correct them. The flag is advisory metadata for Part A's answer policy — never
# a gate, never a filter default, never a reason to hide a page.
VSIR_SAFETY_DOC_TYPES=
VSIR_SAFETY_TOPICS=
# The candidate publish threshold the §11.1 grounded_rate report scores a document against —
# `python -m vsir.eval.grounded_rate [--threshold X]`. R4 says the shipped 0.8 is *chosen, not
# derived*, and this is the knob for deriving it: set it to a value you are considering and the
# report says what that bar would have done to the document's distribution.
#
# It is READ BY THE REPORT AND BY NOTHING THAT GATES, which is deliberate and is not an oversight.
# The number the publish gate actually uses is `vsir.core.health.TRUST_OK_MIN`, a pin in code:
# §5.7's ladder is reviewed and released, because a deployment that could re-tune what "trusted"
# means would be a deployment that could turn F14 back on by editing an env var. So adopting a
# threshold is a RELEASE — change the pin, ship it, and the run record and the collection
# fingerprint both witness which release decided it (§15 Factor III).
#
# Set from the M2b distribution; see the run report for the rationale (R4). Provisional until
# `vsir eval corpus` re-validates it at corpus scale (§12.6), and `vsir publish --override
# grounded_rate --reason "…"` exists so a mis-set bar cannot strand a document silently.
VSIR_GROUNDED_RATE_THRESHOLD=
# The VLM credential. Required only when VSIR_VLM=gemini. Leave empty here — this file is an
# example, and a real value belongs in the platform secret store.
VSIR_VLM_KEY=
