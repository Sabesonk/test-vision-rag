  "schemaVersion": 1,
  "pageVersion": "sha256:c36c5b5c5c60bce66e6e23b5c697a9177b1d8c5d84131dd078dbb3812a5eaaae",
  "claims": [
    {
      "id": "claim_a11975a5e2fe4285912771fc94648f06",
      "statement": "Authentication is default-deny ASGI middleware keyed on path rather than a per-route dependency, so a route added later is protected before it is written — protection is not something a route opts into.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/auth.py#L15-L23",
          "version": "repo-lines-v1:sha256:2b100b307a775de152bcf54b8087c1650b978d38c4a2eb367c1b18e3f4f98ae7:"
        },
        {
          "resource": "repo://backend/vsir/serve/auth.py#L248-L260",
          "version": "repo-lines-v1:sha256:5fa429df1449240dad4caea4a8d92585b785e4304b2ce65ab24bb2f99c82a967:"
        }
      ]
    },
    {
      "id": "claim_031699d200354d39a016b24bbe8d361c",
      "statement": "The unauthenticated surface is three separate sets — probes, documentation pages, and the console page — kept distinct because each is free for a different reason and may only grow for its own; anything returning corpus data, a run, a raster or prose belongs in none of them.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/auth.py#L52-L91",
          "version": "repo-lines-v1:sha256:13ed8381e4288326cb4f1622b65a001e0306041cf9979b586ad274540f26761d:"
        }
      ]
    },
    {
      "id": "claim_2a5a9169ca57432a9f1c50b122f3adc3",
      "statement": "The documentation and console paths are free because a browser cannot attach an Authorization header to a plain navigation, and serving them authorises nothing: the published document declares a bearer requirement on every operation.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/auth.py#L57-L83",
          "version": "repo-lines-v1:sha256:d6ee6fb8fb0078e8356ea4277b3d2b0e45957842619b6c328ab3e9cee514f699:"
        }
      ]
    },
    {
      "id": "claim_1bd66339803e4d3ab193b99f3af43e4c",
      "statement": "Caller identity is derived from the presented token alone — there is no user header, query parameter or body field — because a caller who could name itself could name somebody else in the log whose purpose is to record who spent the money; client identity headers are read only to report that they were ignored.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/auth.py#L24-L30",
          "version": "repo-lines-v1:sha256:b2642abec8a7277a7fdf828a5a1cf995e4fe35fff893949109726e2686e6dfe5:"
        },
        {
          "resource": "repo://backend/vsir/serve/auth.py#L96-L99",
          "version": "repo-lines-v1:sha256:d710e52153934231e5c04e6ddb8e9ddeab5af4566cea0a996dfa88f13f911a50:"
        }
      ]
    },
    {
      "id": "claim_cd5a64c681e44a3c8802fc3430bd78e8",
      "statement": "A presented token is reduced to a domain-separated SHA-256 prefix and compared against digests of the configured tokens, so the comparison is between hashes rather than secrets and the identity reaching an audit line is by construction not the credential.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/auth.py#L155-L165",
          "version": "repo-lines-v1:sha256:e16bafd732a5baafed1d5e85db287d4d7a70361f96fb6877ec0999457237e11b:"
        },
        {
          "resource": "repo://backend/vsir/serve/auth.py#L31-L43",
          "version": "repo-lines-v1:sha256:dd559f011667d524bba0fa001a3dc19fa43c9e6db2bdd917450a62eafd547165:"
        }
      ]
    },
    {
      "id": "claim_a978cfb967b448419873ad67d130d7cd",
      "statement": "Liveness touches no backing service and stays green whether the store is up or down, because a liveness probe that failed on a backing-service outage would turn that outage into a fleet-wide restart loop.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/app.py#L1371-L1375",
          "version": "repo-lines-v1:sha256:7b35ea9a556e7a8e417ded571192b89b7454ab5a972951326c4284f33e279d1a:"
        }
      ]
    },
    {
      "id": "claim_73b2196dfa904ebba97975136929f975",
      "statement": "Readiness re-runs the whole boot check list per probe in a worker thread and goes red on a failure or on a check that could not conclude, carrying a named reason that distinguishes somebody else's outage from a deployment awaiting its first ingest.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/app.py#L1376-L1416",
          "version": "repo-lines-v1:sha256:e93db457be1f80aafcd6648bb5113d90601366cc5e76e42b9bcdc7f716427605:"
        }
      ]
    },
    {
      "id": "claim_48fca40be4b647fea8dc4eb50c4ffce7",
      "statement": "Each of the eight tools has its own route and the generic tool route stays registered beneath them; the named routes exist for the published description rather than for dispatch, because one generic operation with an untyped body gave integrators a single untyped call for eight tools with nothing in common.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/app.py#L1418-L1442",
          "version": "repo-lines-v1:sha256:88e8bcd7af23e9a622ca9828e06b8ce4a3ad4351e023762c582cbd6f152c35df:"
        }
      ]
    },
    {
      "id": "claim_48c00dff369a496994d83b4b36e9f5b5",
      "statement": "The per-tool routes are generated from the tool table in a loop as thin closures over one transport, so a tool cannot get a route without being in the table or be in the table without getting a route, and registration order lets the generic route catch every unknown name as a typed 404.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/app.py#L1430-L1442",
          "version": "repo-lines-v1:sha256:049cf3f208be187cfa3223a3ba41884a683edcc948488ffbb6e46836cc6648cd:"
        },
        {
          "resource": "repo://backend/vsir/serve/app.py#L1495-L1530",
          "version": "repo-lines-v1:sha256:7c7bb0005c2c85b47823686d2e3d048fe2c8cab5fef9c63280a08f0974b0baee:"
        }
      ]
    },
    {
      "id": "claim_3e604379519b4e97801738155ee1d019",
      "statement": "The ask route validates its body in the route rather than through a typed framework parameter — whose failure would be a 422 with a JSON pointer instead of a switchable code — and runs the loop in a worker thread because it makes a series of blocking calls.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/app.py#L1651-L1662",
          "version": "repo-lines-v1:sha256:5f32aee07c13d388ed2192b8e15e03570860ff45d13af2cfffa3fb76f3488d5b:"
        }
      ]
    },
    {
      "id": "claim_48ea23679886407fb340a72fa8b89d05",
      "statement": "The corpus management routes are queries over the collections ingestion already writes, computing nothing ingestion did not record and storing nothing of their own, so they cannot drift from what a search sees and every replica answers identically.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/manage.py#L10-L16",
          "version": "repo-lines-v1:sha256:cc1db0087a1c8d4a46a2ec47333be45e34b7378dd1a4c73eb247816192cd8973:"
        }
      ]
    },
    {
      "id": "claim_982b89cdade34825ae55acaf9431844c",
      "statement": "The corpus surface uses exact counts throughout at some latency cost, because a management surface is where somebody decides whether an ingest was correct and an estimated page count short by two is indistinguishable from an ingest that dropped two pages.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/manage.py#L18-L23",
          "version": "repo-lines-v1:sha256:379540d8c585e6fe3c0e47e0e58a40b6dd63c635f9b216abf7d5223f6bb7eb65:"
        }
      ]
    },
    {
      "id": "claim_ae18f27747c94e80967fbd29ee5a599c",
      "statement": "Nothing on the corpus surface mutates: retirement runs inside a publish where the run record is its evidence, and a bare retire endpoint would be the one call on this surface that silently changes what every future search returns.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/manage.py#L24-L28",
          "version": "repo-lines-v1:sha256:2ecb6a6fd2b75587bf8254bd1eafb028270858dae9032ff5b3db2d9f3810ccc5:"
        }
      ]
    },
    {
      "id": "claim_023c002048844141a98a68624edae039",
      "statement": "Run exports are streamed from the index with nothing written to the instance's filesystem, and the first line is pulled before the response starts so an unknown artefact is a typed 404 rather than a 200 whose body turns out to be a traceback.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/app.py#L2050-L2088",
          "version": "repo-lines-v1:sha256:85c7716682653a59cf5cd7dbf0118a7de3cf7c31043ee110caa238473f1c07c8:"
        }
      ]
    },
    {
      "id": "claim_e77533d003d34017927c06c07d557b71",
      "statement": "The metrics endpoint computes its gauges from the control plane on each scrape rather than from in-process counters, because a counter in memory reports a different number per replica and resets on every deploy — measuring the deployment rather than the corpus.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/app.py#L2091-L2107",
          "version": "repo-lines-v1:sha256:f6d87a8fd782289d76927429fa2953cd551f550d88ec981e3c7cab178ec65734:"
        }
      ]
    },
    {
      "id": "claim_fb06da93747941bcbe9ff6ebc20debd2",
      "statement": "The document upload route does not implement ingestion: it spools the bytes, refuses what it can cheaply, and runs the same subcommand an operator would from the same image — answering 202 with a run id whose progress is polled from the control plane, so a poll works from any replica.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/ingest.py#L1-L16",
          "version": "repo-lines-v1:sha256:321117008227a3e23fbc16d292f875c931f836230dd904f30d2373be6d4f71aa:"
        }
      ]
    },
    {
      "id": "claim_6d3ce51ad2874474b2d9c2ab0c76b630",
      "statement": "The upload route states two properties it gives up: the web process becomes briefly stateful because the PDF library needs a file, with the spool deleted when the child exits and the durable copy held by the document store; and the spend decision moves to whoever can reach the port, which is why a live-configured release refuses without the paid switch — a per-release switch rather than a per-caller scope.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/ingest.py#L17-L40",
          "version": "repo-lines-v1:sha256:ebc3a46001b85786563e4d305232e30b7bc5252b9185e154c30bd7662dee610b:"
        }
      ]
    },
    {
      "id": "claim_382a5d7784e343fcbc646080cb27ecc8",
      "statement": "The read quota is held as a point in the control plane rather than in process memory, because the web process scales horizontally and an in-memory counter becomes one counter per replica that resets on every deploy.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/budget.py#L1-L12",
          "version": "repo-lines-v1:sha256:93c6d98d7218ebeacd459c5c149e5e2ebd87d934c1d55e62bd81c6cfc788f966:"
        }
      ]
    },
    {
      "id": "claim_79fddd79540949f2b7ca81e115a7bbfc",
      "statement": "The budget ledger is explicitly advisory for the same reason the ingest lease is: with no compare-and-swap two concurrent reads from one caller can both observe the same remaining count, bounding the over-spend by that caller's own concurrency and making it a cost bug rather than a correctness bug.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/budget.py#L14-L20",
          "version": "repo-lines-v1:sha256:e640461e0314b9f0222b160a7cdd33de5721b52a30eb7f5c171d334adfe6337a:"
        }
      ]
    },
    {
      "id": "claim_7d149f24d7734aafb415b482bb2e8be0",
      "statement": "The quota window is a UTC day whose period key is part of the point id, so a new day is a new point with no sweeper, cron or expiry to get wrong; exhaustion is a 429 rather than a truncated result.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/budget.py#L22-L30",
          "version": "repo-lines-v1:sha256:ff0e2055f1a8ae490473d0fb263989586c40385140db7025298b7f664f4a1804:"
        }
      ]
    },
    {
      "id": "claim_6b55c638f42445188fb360077bcdb251",
      "statement": "Exactly one audit line is emitted per read and per fetch with exactly ten fields, and the line model forbids extra fields so the schema cannot be widened with document content — an audit stream carrying page text would be a copy of the corpus in a log aggregator.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/audit.py#L1-L7",
          "version": "repo-lines-v1:sha256:dde66c06b6be854e345f45b76982dd203ebec718e6533bfbe894c36d7732d567:"
        },
        {
          "resource": "repo://backend/vsir/serve/audit.py#L21-L26",
          "version": "repo-lines-v1:sha256:7f6e7cfcc2d63015b8b283a4ddebb3eb01bd8e021b29af5cc25ae85fa2d208d9:"
        },
        {
          "resource": "repo://backend/vsir/serve/audit.py#L85-L95",
          "version": "repo-lines-v1:sha256:25f462cafbfc70ee5adcd5d57c8fb1c039b09bba92113be803fb8cab329fe552:"
        }
      ]
    },
    {
      "id": "claim_feef6e1cd17d4b8ab0467930eb15a015",
      "statement": "Cost information goes in the audit line and never in a response body, because the operator's question about who spent what and the agent's question about how many reads remain are different questions that get different channels.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/audit.py#L8-L14",
          "version": "repo-lines-v1:sha256:092237f266215491029e4faf40ee4656d1a5884a789f2e4efc4ea00472f034ed:"
        }
      ]
    },
    {
      "id": "claim_252e16ca46214c8c88fcface044f73e1",
      "statement": "Only the two consuming tools are audited while free tools log at debug level, because a line per free call would bury the records that matter.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/audit.py#L15-L20",
          "version": "repo-lines-v1:sha256:1d8cfd85ba32106369dc06f645499ed2695f51e73794ab2b9c3f744d39dd159c:"
        },
        {
          "resource": "repo://backend/vsir/serve/audit.py#L57-L60",
          "version": "repo-lines-v1:sha256:a2966f115fa2cd4be57ff2950c7a7e0e17ff9d0693196e9aaa4f6b147ef6285f:"
        }
      ]
    },
    {
      "id": "claim_406391088c9045c29b6852af09e572c4",
      "statement": "The audit fields are nested under a single key rather than spread across the log record, because the redactor blanks credential-shaped field names and a top-level token count would be emitted as redacted.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/audit.py#L27-L33",
          "version": "repo-lines-v1:sha256:7b2dc406f33573cea5d286b218bd83446f86a3f57e1227caa28dbe53a6874129:"
        }
      ]
    }
  ],
