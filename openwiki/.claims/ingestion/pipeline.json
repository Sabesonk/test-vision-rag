  "claims": [
    {
      "id": "claim_ff263c322d4f4478b7c7a69c40532148",
      "statement": "The ingest pipeline is eleven named steps driven by one command with an --until flag that can stop after any of them, so each step is reviewable on its own.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/cli.py#L3620-L3628",
          "version": "repo-lines-v1:sha256:477533fa33da26e0cd27dbc62094d972a47a8239ff1826dc9e3c3685e8bbc277:"
        },
        {
          "resource": "repo://backend/vsir/cli.py#L589-L595",
          "version": "repo-lines-v1:sha256:fa0ff24e09c6b5cf70585b8eb8ed428c5f1b2ebff0c2c6bcbd64d2e43e004fe2:"
        }
      ]
    },
    {
      "id": "claim_25ab72b9abd042da8ff41d616774d78b",
      "statement": "Exactly three steps — embed, index and publish — require a reachable Qdrant and refuse without one, because step 09 reads the embedding cache off the index, step 10 writes to it and step 11 flips visibility, so running them blind would re-bill every vector the index already holds.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/cli.py#L596-L601",
          "version": "repo-lines-v1:sha256:88a9d9fe6ea7e4ff4d38c441400db7efbdd0ea6fe8e68dd584b796f74a709af1:"
        }
      ]
    },
    {
      "id": "claim_7115d90affc34e3c98b9de2e9d854807",
      "statement": "A store-backed run claims its run point at step 01, before the first model call, so an unreachable store is named before anything is spent and a run that dies mid-flight still exists in a state that says so.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/cli.py#L896-L906",
          "version": "repo-lines-v1:sha256:02b4ea520f556fd95a4867c640f70b6c35077ec024c89090a6e99d65cf2557b9:"
        }
      ]
    },
    {
      "id": "claim_dcbc7d98444946e2acb51a3ae2541279",
      "statement": "Resuming a run against a different document is refused by name, because it would write this document's pages under that run's id and the publish step would then flip a set of points nobody intended.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/cli.py#L907-L917",
          "version": "repo-lines-v1:sha256:f1c9f1b86401ac3c1d562b1722c32092a26b51ff5550f2601586d599d5c79a70:"
        }
      ]
    },
    {
      "id": "claim_05e31c1b63044b2a8e0df23d243e22ed",
      "statement": "Step 01 derives document identity only from the filename, the file's own metadata and the uploader, and contains no grammar of any kind — no regex, taxonomy or keyword list — because a classifier at the door would be unversioned corpus knowledge in front of every later step.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/manifest.py#L1-L18",
          "version": "repo-lines-v1:sha256:79724da03d64fcd311dda51a47838dcc105a71f094da513931b521bb07cb3010:"
        }
      ]
    },
    {
      "id": "claim_83c11600b8dd4fb0b33bfcec3d396885",
      "statement": "An undeclared facet is recorded as undeclared rather than as its truthy default, and the same applies to the revision, so a later step can distinguish \"the operator said unknown\" from \"nobody said anything\" — the distinction whose absence previously discarded the model's own classification.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/manifest.py#L19-L30",
          "version": "repo-lines-v1:sha256:121a1fabfa02d9c739be27a26c57518cf15e345dbf39f64309d3b5ad5e47e21a:"
        },
        {
          "resource": "repo://backend/vsir/ingest/manifest.py#L40-L48",
          "version": "repo-lines-v1:sha256:a402b61d6448631015191ada277099e09472d304a6809c373573c9e3174734be:"
        }
      ]
    },
    {
      "id": "claim_476231e0dc7d4812a40376e372764a43",
      "statement": "Step 02 is the only writer of the text payload field, always extracts from the full page with no clip argument, and a conformance grep keeps the extraction call out of every other module so a second extractor cannot appear.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/probe.py#L1-L19",
          "version": "repo-lines-v1:sha256:434ac77a6691ae17e227e07d8f1b740ba93269f082157f11d8fea2da82b100e0:"
        }
      ]
    },
    {
      "id": "claim_905b26c4ffc64010b2cc4404cd32459f",
      "statement": "Text extraction is unconditional rather than gated on a document-level has-text sample, because that guard destroyed the text of every mixed document — a scanned cover over a born-digital body averages below the threshold on a front sample — while per-page extraction already returns empty for a page without a text layer.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/probe.py#L18-L27",
          "version": "repo-lines-v1:sha256:b77c0efedb62e1c258f6ab0fbe9681d4246de433d18ddb7ec7a0e1cb768b69e2:"
        },
        {
          "resource": "repo://backend/vsir/ingest/probe.py#L44-L49",
          "version": "repo-lines-v1:sha256:d76328871f81db8ed7ae722c4fdbb9007664952c5391b9a191751bf8da6917ca:"
        }
      ]
    },
    {
      "id": "claim_dd6a41d079684af0bb6f7bc882de197a",
      "statement": "There is deliberately no OCR: the text layer is evidence for whether a code is printed on a page, and an OCR guess in a corpus of one-character-apart codes would verify a hallucinated code — so a scanned page yields nothing and is disclosed as not searchable.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/probe.py#L28-L34",
          "version": "repo-lines-v1:sha256:be5d029caf3fa8869d43982cd47fc07683f81a3b158d98329c829cce7b9d989a:"
        }
      ]
    },
    {
      "id": "claim_976f7b4e77be47cca26f5f371b5f7071",
      "statement": "The PDF library version is recorded on every page because it is the single point of truth for exact search, making a version bump a re-run of the crop and offset fixtures rather than a silent change.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/probe.py#L38-L42",
          "version": "repo-lines-v1:sha256:d8d36154d75b8af6787f94d23941dc31284001ed98148bc0b534d03794609f3c:"
        }
      ]
    },
    {
      "id": "claim_3ddea7794a9e4d0e818bfe464322af60",
      "statement": "The source document is deposited into the document store at step 02 and nowhere else, because doc_id and revision are only authoritative after step 01 and the content hash only exists after step 02 — and since the HTTP upload route runs this same subcommand, an upload deposits through exactly that line.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/cli.py#L943-L955",
          "version": "repo-lines-v1:sha256:1ce97dd38f7f73aa25dc0e1947e1090bdd27eb67047cb2e0e651e7d275e0f1c9:"
        }
      ]
    },
    {
      "id": "claim_a0fbf7a3403145dea89728a3bc065eaa",
      "statement": "Rasters are rendered in memory and never written down, replacing an earlier design that wrote every page at both dpi values before validation — which produced stale record paths that failed every page read and instances whose answers depended on files other replicas lacked.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/render.py#L1-L14",
          "version": "repo-lines-v1:sha256:645e05f1b37dda2d77fabf957e1f129fe714e4bed531cda50ad72b662c0862ea:"
        }
      ]
    },
    {
      "id": "claim_384f8cff892e4d44b20b80b6004fc141",
      "statement": "Two dpi values serve three uses: 150 is the raster that gets embedded, 220 is pinned and shared by extraction and by read because it is a cache-key input a caller cannot change, and the fetch tiers feed no key and are cache-only.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/render.py#L15-L23",
          "version": "repo-lines-v1:sha256:dd86cc632907532834a2c383ae9a03ecf8c31594ee70a60eabd7a8d1771630ce:"
        }
      ]
    },
    {
      "id": "claim_25cde03740cf4b5ea5057dd70fb58371",
      "statement": "Step 07 runs two independent offset checks — a structural one decided by the same function step 06 uses, and an observational one comparing a model-read printed page number against that page's own text — and a failure bisects rather than emitting records for a window whose pages cannot be placed.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/derive.py#L8-L21",
          "version": "repo-lines-v1:sha256:2acfee9be50334db3062ef43c356dbc677c07d89cc1ec86fd630ca480e405c01:"
        }
      ]
    },
    {
      "id": "claim_b6aef8a8d68d4324a1cb0fecf86b06ab",
      "statement": "A single offset witness is deliberately not enough to raise: the neighbour check reads the whole document so the predicate is invariant under bisection, and over the real corpus one witness fires on 22 pages across 11 of the 98 documents declaring page labels, every one a false positive — so the check requires two witnesses, or one when nothing in the window confirms its own label.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/derive.py#L22-L38",
          "version": "repo-lines-v1:sha256:41f7e776f4a821f3cd3b318df0ea9f59c427e2ff91bc8d91412ed341e19ab4cb:"
        }
      ]
    },
    {
      "id": "claim_75e7b40944074815add3e7b94408a44f",
      "statement": "The allowlist gate is gone from derivation: there is no identifier grammar, classification or keyword list, because a code is findable only by being in the page text that the probe alone writes — what survives of the gate's purpose is the grounded rate and the list of codes the text backs.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/derive.py#L40-L47",
          "version": "repo-lines-v1:sha256:6e66584bf3ac79a9f3e9d75daae76ff5b686dc06677ec9f3ef8f8e8f4297a0d5:"
        }
      ]
    },
    {
      "id": "claim_8e1afc0b1f0c47a889216327d797c2fa",
      "statement": "Reattribution moves a code the model reported on one page to an adjacent page only when the code is absent from the reporting page's text and present in exactly one neighbour's text within the same window, recording where it came from; a code printed nowhere stays put and counts against that page's grounded rate.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/derive.py#L49-L55",
          "version": "repo-lines-v1:sha256:4bb38c0561919a02b7f105e212deb5b996f065eeff7eb7d77f28548b80724663:"
        }
      ]
    },
    {
      "id": "claim_8ba970d66e994730b48be04b4916d9ce",
      "statement": "Stitching is the only place section extent is created, because a window fold can cut through a section and the call on one side cannot see the other — the model reports presence per page, and extent is the min and max over sightings once every window has returned.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/stitch.py#L8-L24",
          "version": "repo-lines-v1:sha256:b8e973b7fc719a83dd11687851a8142ff3237b58d9025eb73611a15aab85c3f4:"
        }
      ]
    },
    {
      "id": "claim_c3e30fdb7b464d818a15bc08e50c35d2",
      "statement": "Stitching counts the pages declaring a section head and treats anything other than exactly one as uncertain, and keeps the page range and the observed page set separately so a section observed across a gap does not claim the missing page — the gap is disclosed rather than smoothed over.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/stitch.py#L26-L33",
          "version": "repo-lines-v1:sha256:29acced84ffcfdcb007b5e208f9c7b93e4e1de027fd87b7bc9de4809ceb1ed3f:"
        }
      ]
    },
    {
      "id": "claim_64f3110a07e046b9afa6965f5d203ace",
      "statement": "Stitching writes series_id alongside section_id because a section_id carries the revision and a scope expressed with one dies at the next revision, and both are keyword arrays so a page straddling two sections carries both ids.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/stitch.py#L35-L40",
          "version": "repo-lines-v1:sha256:ecbf5747c7bdb53ea5153eeea9d71436172a5ba9471dd3f4888462edd4d2f695:"
        }
      ]
    },
    {
      "id": "claim_a89bffe7dbc34823bc833c4899aeb0ea",
      "statement": "Step 11 prints the full gate table before acting, so a held document is held for a named reason with its worst pages listed, and records the run's cost — embeddings billed and reused, model calls and cache hits — onto the run record.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/cli.py#L1292-L1330",
          "version": "repo-lines-v1:sha256:f93c215b00b524e10e6a5d03f2c39c5978372c6d55999e5dda7c6e9b062e2988:"
        }
      ]
    }
  ],
