        }
      ]
    },
    {
      "id": "claim_a28e1e533bbe41b59516ee0aead400dd",
      "statement": "A single-witness rule was wrong because the neighbour check reads the whole document rather than the window, making the predicate invariant under bisection so a false positive costs the document plus roughly eight paid windows; measured over the real corpus one witness fires on 22 pages across 11 of the 98 documents declaring page labels, every one a false positive.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/derive.py#L20-L28",
          "version": "repo-lines-v1:sha256:91f6dee3fd642f545e9f4930206f04301cc3e6b06d97867544fda2eb0b47c1d6:"
        }
      ]
    },
    {
      "id": "claim_45bff2f8d3bf4af98b9b891e4344789f",
      "statement": "A tolerated single witness is logged rather than swallowed, with the fields the refusal would have carried, so a corpus sweep can count them without re-running the check.",
