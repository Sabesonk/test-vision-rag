  "claims": [
    {
      "id": "claim_40e89e63189545359d20423e458a3c89",
      "statement": "A window is a page range created by the model's attention limit, deleted again by stitching, and never a retrieval boundary — window (attention), section (semantics) and page (index) stay separate granularities throughout.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/window.py#L1-L6",
          "version": "repo-lines-v1:sha256:898aecc64e91f83e159857a05d15f0641ebda482f1ae645b0ca730b1ec5acc91:"
        }
      ]
    },
    {
      "id": "claim_9b91b7bafee64ec0b7840951d947760b",
      "statement": "The window ladder has three rungs — whole document, chapter-aligned, and folded at the cap — and every rung produces windows of at most the cap covering the document exactly once and is parallel; the rung number records only where the boundaries came from.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/window.py#L354-L380",
          "version": "repo-lines-v1:sha256:06886d30cace2f8b61eca634632db3aeb2cb1e7895f2054eb5583bae742d9e81:"
        },
        {
          "resource": "repo://backend/vsir/ingest/window.py#L9-L12",
          "version": "repo-lines-v1:sha256:0bbf2e2e5654e6c70b51a908ecb39d97bb74f2211eb4ac52f082afe7f9ba5207:"
        }
      ]
    },
    {
      "id": "claim_6420ee65bf764435be9cb3839c6f9100",
      "statement": "An inline byte ceiling rules the whole-document rung out for a file too large to hand over in one piece even when its page count would fit under the cap.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/window.py#L338-L353",
          "version": "repo-lines-v1:sha256:36622af78e4d4349050db0c5e46a0150e4967f643d92916e0f7484007b72be61:"
        },
        {
          "resource": "repo://backend/vsir/ingest/window.py#L60-L63",
          "version": "repo-lines-v1:sha256:3e0fd58bb5d978f881fbf8e5aafaf9014079ecb871d766ccde9e4a5b251aa659:"
        }
      ]
    },
    {
      "id": "claim_0ae593c543f246918d19052657423f17",
      "statement": "The fold-at-the-cap rung was restored because the carry chain that justified excluding it disappeared when section extent was removed from the model's output: presence is reported per page and extent is computed after the folds are gone, so two windows that never saw each other reassemble one section.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/window.py#L13-L22",
          "version": "repo-lines-v1:sha256:f1ae76416da3ea60b290674ffa21109d46e352d1cf9729bc913a0a76513c22a1:"
        }
      ]
    },
    {
      "id": "claim_928e0fc040bc4bfd8d37b32b99d63bf7",
      "statement": "Excluding the fold-at-the-cap rung refused 14 documents and 2,719 pages — 49% of a 202-file, 5,578-page working corpus — with eleven of the fourteen declaring no outline at all, including the pilot document, which therefore failed one step before the spend it was waiting on.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/window.py#L24-L31",
          "version": "repo-lines-v1:sha256:e5a98050392b24ec25ce84761564c29ce0839a160ad22fd9929018b8ca4bdfba:"
        }
      ]
    },
    {
      "id": "claim_bfb79cb92fa54797878b583b21111f43",
      "statement": "Windows are bounded below as well as above: a chapter smaller than a third of the cap is folded into its neighbour, because bounding only from above billed one call per sheet on a densely outlined file that declared 8,187 bookmarks over 592 pages.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/window.py#L33-L38",
          "version": "repo-lines-v1:sha256:15a9f46dcd188b8ce71b023a3f9faa394a01d30c04d01c7f795b2fda55c20425:"
        },
        {
          "resource": "repo://backend/vsir/ingest/window.py#L69-L79",
          "version": "repo-lines-v1:sha256:453fdb34f82cda9d0c77347febd6394b5eeeefe203959ae018d209a7fe71ef06:"
        }
      ]
    },
    {
      "id": "claim_4098314267334cbda11a097468082a5f",
      "statement": "The packer applies a floor on the merge rather than filling to the cap, because a chapter-aligned plan that packs to the cap has taken its boundaries from the cap and is the fold rung wearing the chapter rung's number.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/window.py#L307-L337",
          "version": "repo-lines-v1:sha256:0288241871626f6dd63946e516d7d543662b5472134bdbe00786e42855b32141:"
