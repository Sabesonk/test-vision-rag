        }
      ]
    },
    {
      "id": "claim_4835ad4a98ad4899a8ff288858c92f94",
      "statement": "A ground-truth set may declare itself unavailable with a reason and then skips with that reason printed, while a set with neither rows nor a stated reason is a refusal — because a missing file and a file declaring a set unavailable are different facts.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/eval/corpus.py#L440-L479",
          "version": "repo-lines-v1:sha256:d460f958a59f429a4232905d06670f9f3469843a22a92bdeb6ce6b3c9b3123b4:"
        }
