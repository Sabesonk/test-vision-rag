    },
    {
      "id": "claim_5a37b9600a4544ae8155091b7174a535",
      "statement": "A corpus report is green only when nothing was refused, nothing failed, and something was actually measured — so a run in which every set skipped by name is honest output but not a passing report.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/eval/corpus.py#L615-L624",
