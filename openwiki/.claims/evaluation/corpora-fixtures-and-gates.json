    {
      "id": "claim_e56acac844dc441fb8505c6947f91a5d",
      "statement": "An abstention run that cannot measure prints \"abstention_correctness: not measured\" and exits non-zero rather than reporting a ratio, since zero of zero is never 1.00.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/eval/abstention.py#L250-L262",
          "version": "repo-lines-v1:sha256:bfc5beb37d841eef299fdd3a6b4357e30dedf15dfe06d33e73668ed4cb6f1aba:"
