    {
      "id": "claim_31071ea86aec46b892403b42c5588388",
      "statement": "A gate re-baseline must carry the corpus it was measured on, the measurement and a rationale, and is refused when any is missing, when it moves nothing, when it lands below the blocking floor, or when it would lower a safety floor — and it always departs from the specification's own number, so \"exactly once\" holds by construction.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/eval/corpus.py#L172-L189",
          "version": "repo-lines-v1:sha256:358495b606fa9af2db3d585bbe7fb5b3d63e9d05ff29e48ab681704df18d5bc5:"
