        }
      ]
    },
    {
      "id": "claim_f647a644b79c4fa997f5f335f0a8c71a",
      "statement": "verify is bounded on the product of claims and pages rather than either list because the work is that many index counts, and an empty claims or pages list is refused by name since a verdict map with no verdicts reads as \"nothing to answer for\" — the one thing an answer gate must not conclude by accident.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/caps.py#L220-L252",
          "version": "repo-lines-v1:sha256:45bad1cbbca2dc3ae4d5a6fa71dd6d809701b70fa8dc76265e2241eec4e45673:"
        },
        {
