        }
      ]
    },
    {
      "id": "claim_c90aea5063da4ca2ad3d8048f00dd22b",
      "statement": "The skim row limit is a triage bound rather than a cost bound and is refused instead of clamped, because a caller asking for a hundred rows has misunderstood the move and silently returning twenty-five would let it believe it had seen a hundred — whereas lookup's cap bounds a page of a set and has no upper limit.",
      "evidence": [
