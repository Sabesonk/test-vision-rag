          "version": "repo-lines-v1:sha256:e68871ad60932f7883926dfd0395f0750c344d1725c930f1a79c04bacb1f3537:"
        }
      ]
    },
    {
      "id": "claim_d5a6372c12ce4529b8cb6785b420a35d",
      "statement": "A malformed region is refused rather than clamped, because clamping an out-of-range crop would return a different crop from the one requested and report success.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/caps.py#L148-L167",
