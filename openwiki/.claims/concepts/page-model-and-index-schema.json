    {
      "id": "claim_09e43b91aa7b49b29ad33c927d748444",
      "statement": "The ingest probe is the only writer of the flat text field and it extracts the full page rather than a crop, which is what confines model output to the separate opt-in vlm_codes surface whose hits are permanently labelled unverified.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/record.py#L15-L18",
          "version": "repo-lines-v1:sha256:525e6f6aed03ac84d55ecb46b698f7b23d6e5cdc730ab8e0525a08d964c5a1a1:"
