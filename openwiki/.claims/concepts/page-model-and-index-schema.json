    {
      "id": "claim_fe3bded9e7af439ab070188d52c5643e",
      "statement": "Vectors are not part of the page payload — they travel beside it in the upsert — because a vector is never read by a filter or returned in a response.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/record.py#L141-L145",
          "version": "repo-lines-v1:sha256:e0c9cb293574f2236528367208bad110fa8d642738bbabf176b54138f6125097:"
        }
