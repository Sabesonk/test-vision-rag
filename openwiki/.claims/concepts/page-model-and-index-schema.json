        }
      ]
    },
    {
      "id": "claim_04ac50d5253b4b798acc2ab3a1507dab",
      "statement": "series_id deliberately omits the revision so that a scope expressed as a series survives a revision boundary, which a section_id cannot.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/ids.py#L88-L101",
          "version": "repo-lines-v1:sha256:6e0168fb75856ae74876be7d5b88bf07107b741efed639bf6b4cdd15fac85947:"
        }
      ]
    },
    {
      "id": "claim_d28c74dde7674e61bc29f28d17187e5c",
      "statement": "run_id is a ULID — 48 bits of millisecond time then 80 bits of randomness in Crockford base32 — so run ids sort lexically into time order without an index, two runs started in the same millisecond still differ, and a transcribed id cannot become a different one.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/ids.py#L116-L134",
          "version": "repo-lines-v1:sha256:48f3ad4adecd08802b38398ba4f342474e6796057dfd063c483d8dfa0c118579:"
        },
        {
          "resource": "repo://backend/vsir/core/ids.py#L25-L30",
          "version": "repo-lines-v1:sha256:9e8f0a9687db22cdea3d1f19e8e06a717d875f87f61dab3f65f3baaa546164f5:"
        }
      ]
    },
    {
      "id": "claim_a09a8e4ad7de47f99d9312d15f33ee9f",
      "statement": "The page record is validated with extra=forbid and split into a flat facet zone and nested content/provenance zones, kept visibly different because Qdrant will filter a nested key by running an unindexed scan — a silent recall loss rather than an error.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/record.py#L1-L13",
          "version": "repo-lines-v1:sha256:7def6b871b250eeac852004bae9e5355615a3fde380120c3df78ec96cd5d1c36:"
        },
        {
          "resource": "repo://backend/vsir/core/record.py#L140-L180",
          "version": "repo-lines-v1:sha256:6bda879d8153ecfe0a76877973495a1f585bc048bd5be2c9fbdf67d27955cce0:"
        }
      ]
    },
    {
      "id": "claim_5e1c41b8781d4b86862a0a3227aa457e",
      "statement": "section_id and series_id are arrays on the record so a page straddling two sections carries both ids and a scope matches on any element; a single scalar per page is how a scope silently excludes a page it should have contained.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/indexed.py#L30-L36",
          "version": "repo-lines-v1:sha256:331c645c54edc4f89dbaeab1df9b414076801ecd68150871415cee7ab0b5b32c:"
        },
        {
