    },
    {
      "id": "claim_097e6aef506245a1ad5a77cc1101b04d",
      "statement": "The trust ladder is a pin rather than configuration: page_trust maps a grounded rate onto ok at 0.8 and above, degraded down to 0.2, untrusted below that, and no_text which nothing promotes — so no deployment can re-tune what trusted means by editing an environment variable.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/health.py#L28-L31",
          "version": "repo-lines-v1:sha256:d1ec00b7d73a82fa62afc80ff162aa7d30872245ad1792e55405cc8dde0a4fdb:"
        },
        {
