    },
    {
      "id": "claim_fc03e39615224f39926ccd0f6e23fff5",
      "statement": "scope_keys() is INDEXED minus the two text surfaces, so text and vlm_codes cannot be used as caller filters and remain reachable only through the tools that own the single exact-match path.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/indexed.py#L71-L84",
          "version": "repo-lines-v1:sha256:afc7f06c936d558ad1d3f8574a058c3828e372d6591acf4705d416c0dd04b1ad:"
        }
      ]
    },
    {
      "id": "claim_a6968421a96e45148753ba13afb15bb4",
      "statement": "grounded_rate is the share of the model's claimed codes that the page's own text prints, measured with the same phrase-over-variants question the index is asked rather than a token-set intersection — which could not match a multi-token code and would push a healthy document under the publish gate.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/health.py#L19-L27",
          "version": "repo-lines-v1:sha256:d5ab1fef9ba06e6d4546d83d00baf1f27793b9aec4178caaf9ce8edb7b26deae:"
        },
        {
          "resource": "repo://backend/vsir/core/health.py#L52-L60",
          "version": "repo-lines-v1:sha256:0de2a12a62721f6f0c32108aa3655e5124e188cdf625a336ff031d81eb2efd46:"
        }
      ]
    },
    {
      "id": "claim_73618a8fcffd4a22868feb8e51bdda7b",
      "statement": "grounded_rate is None rather than 0.0 on a page with no text layer, and every aggregate ignores those pages, because scoring an unreadable page zero would report \"extraction is broken\" where the truth is \"there was nothing to check\" and would quarantine exactly the scanned documents that must be published but unsearchable.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/health.py#L73-L86",
          "version": "repo-lines-v1:sha256:5e536ea7aa2ee11df99643ae7d72b4b9cfcfc9e1d5d43de6652c58e4c48b3eb1:"
