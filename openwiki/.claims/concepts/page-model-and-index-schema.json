    },
    {
      "id": "claim_2618e6471bd041d39d0e21135198a0f3",
      "statement": "No page record carries an image path of any kind, because rasters are re-rendered on demand and a record must not depend on a file that may not exist on the instance serving the request.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/record.py#L18-L21",
          "version": "repo-lines-v1:sha256:fe2dbe34379c6ff7f5f60b3a6f7264e0f096769c259f25740f88bcb1ac881cbd:"
