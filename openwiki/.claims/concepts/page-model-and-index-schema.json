  "claims": [
    {
      "id": "claim_7360231f52b342d690f8812a3c2b8729",
      "statement": "point_id is a deterministic UUIDv5 of the page id rather than a random id, so re-ingesting the same page overwrites its point instead of adding a second one — which is what makes doubled totals structurally impossible.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/ids.py#L1-L7",
          "version": "repo-lines-v1:sha256:e7bec6c2756dae49ac74078f8dfa360e28f5ea5df36009b453d359d48c7aaff5:"
        },
        {
          "resource": "repo://backend/vsir/core/ids.py#L104-L114",
          "version": "repo-lines-v1:sha256:c6c161e2c8d6cbbbdc8fb9636f1659d7fe380bc133ecc241a0b9ef68de01a130:"
        }
      ]
    },
    {
      "id": "claim_8c2a39049def4137acf24dc832956aae",
      "statement": "Only the canonical page-id spelling parses: over-padded forms such as #p0001 are refused, and point_id canonicalises through that parse, because a lenient parse with a string-keyed hash would give one page several point ids and turn a mis-padded citation into a silent miss.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/ids.py#L36-L40",
          "version": "repo-lines-v1:sha256:767b05cb20d7f31959bf5a86e3d86e8ec66ea2680f268402d7709ade34a8bc3e:"
        },
        {
          "resource": "repo://backend/vsir/core/ids.py#L61-L82",
          "version": "repo-lines-v1:sha256:ed3c0f7d51e44e0db7ca727433ea6b0274e77b33e65dbe256afbf156d4536c5c:"
        }
      ]
    },
    {
      "id": "claim_43508d43d6834614951e3ef184bb552b",
      "statement": "The UUID namespace point ids hash under is pinned to uuid.NAMESPACE_URL and asserted by a test, because the namespace is part of the id and changing it would orphan every point in the collection.",
      "evidence": [
        {
          "resource": "repo://backend/tests/unit/test_ids.py#L1-L40",
          "version": "repo-lines-v1:sha256:7c7b7d1cb6db8370b0807601aaa286ddd08a25faff704d075b12ee491329adb0:"
        },
        {
          "resource": "repo://backend/vsir/core/ids.py#L11-L23",
