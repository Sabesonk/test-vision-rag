        }
      ]
    },
    {
      "id": "claim_d1cfb36308004e4287e5f7dfbb1c1199",
      "statement": "A page that has a text layer and no claimed codes rates 1.0, because nothing was claimed and therefore nothing is unbacked.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/health.py#L73-L86",
          "version": "repo-lines-v1:sha256:5e536ea7aa2ee11df99643ae7d72b4b9cfcfc9e1d5d43de6652c58e4c48b3eb1:"
        }
