        }
      ]
    },
    {
      "id": "claim_a8100c81b10648bdae5b64823ff1dd25",
      "statement": "is_current defaults to False on the record type itself, so a page being unqueryable until the publish gates flip it is a property of the type rather than something each writer must remember.",
