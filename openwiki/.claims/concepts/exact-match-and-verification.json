  "claims": [
    {
      "id": "claim_86e3891eb85147e9b884ccb2aac704e1",
      "statement": "exact_filter is the only exact-match code path in the codebase — lookup, verify, the answer gate and the ingest-time codes_in_text derivation all call it — so the tool that finds a page and the check that confirms it cannot disagree about whether a code is printed there.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/exact.py#L1-L21",
          "version": "repo-lines-v1:sha256:5ae28a52033bebbc7150f72a4cd47feef525350c2bd96e48e1509050cef8e2ce:"
        },
        {
          "resource": "repo://backend/vsir/core/exact.py#L73-L99",
          "version": "repo-lines-v1:sha256:29fede0a709be838dd8d8652e1b3e5ea6363c5d37a6b6f4d2da37719a5566888:"
        }
      ]
    },
    {
      "id": "claim_7004f6c468e2495187c135b6389c64fd",
      "statement": "The exact filter is a disjunction of MatchPhrase conditions over the label's variants, so matching is ordered and contiguous rather than any-order token matching; MatchText and MatchTextAny are banned under serve/ by a conformance grep because any-order matching would return every page mentioning a common token.",
      "evidence": [
        {
          "resource": "repo://backend/tests/unit/test_conformance.py#L140-L147",
          "version": "repo-lines-v1:sha256:aa3971cb9b20211eaaf34c312239381abdb452665fa9a003a112e5b7b3e37f0d:"
        },
        {
          "resource": "repo://backend/vsir/core/exact.py#L84-L99",
          "version": "repo-lines-v1:sha256:3f8971a440431557f62ac4527eb72e15e6d55b0cdd3583621141798c599c2c26:"
        }
      ]
    },
    {
      "id": "claim_0db7495c84d54049b6c5a17a38dd4bb9",
      "statement": "exact_filter takes the text surface as a parameter rather than existing as two functions: `text` is written only by the ingest probe and is verified by construction, while `vlm_codes` is the opt-in surface whose hits are permanently unverified.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/exact.py#L73-L85",
          "version": "repo-lines-v1:sha256:4d9694091d58408a3805b0772e8d3e64daeddffc556687c2d5d0ff04075d6307:"
        }
      ]
    },
    {
      "id": "claim_2532791ec6364c4cb089b4626028c29a",
      "statement": "exact_filter deliberately does not add an is_current condition; each tool injects current-revision scoping itself so the constraint stays visible at the call site.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/exact.py#L18-L20",
          "version": "repo-lines-v1:sha256:3ba435f0162b8951c3e17113d04126da65e7af83093055de29958eb236dab0b9:"
        }
      ]
    },
    {
      "id": "claim_3065f549e7544975891da1a5fdfa2453",
      "statement": "variants() returns at most three spellings of the same characters — whitespace-collapsed, whitespace-removed, and re-spaced at letter/digit boundaries — deduplicated and order-preserving, so a label already single-shape yields fewer than three.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/variants.py#L41-L58",
          "version": "repo-lines-v1:sha256:30530665e189eeba876d00855bdb6a6ced034c4116e20d6c8d187bd0dad0f924:"
        }
      ]
    },
    {
      "id": "claim_02b0c4b815a74c46b132456b1eb8a6c1",
      "statement": "A variant may only re-space characters and may never add, drop or change one, which makes it structurally impossible for a lookup on one code to return a different code; preserves_characters() exposes that property as a callable predicate rather than leaving it only in a test.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/variants.py#L1-L17",
          "version": "repo-lines-v1:sha256:db2e2b200fc4a08eaa43065825d6eba82f07fd36956bb9e7c347504cf6d915a4:"
        },
        {
          "resource": "repo://backend/vsir/core/variants.py#L59-L66",
          "version": "repo-lines-v1:sha256:8bb7feb86355073d70d2e0b953af89d274eadf97aa059d47bcab3557727e3dde:"
        }
      ]
    },
    {
      "id": "claim_76c87cdaec6f4d4c8c85ce1dee6f436b",
      "statement": "Whitespace collapsing and letter/digit boundary spacing are the only permitted string normalisation in the codebase: there is no identifier grammar, no normalisation table and no per-corpus regex.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/variants.py#L14-L18",
          "version": "repo-lines-v1:sha256:80fca4ccb3d8ab071e57473ab38854690ed48869806c8d2bc919f780ec70e572:"
        }
      ]
    },
    {
      "id": "claim_ea1b677298fc4752a45dd239c056bee6",
      "statement": "No similarity measure exists anywhere: conformance tests refuse a declared fuzzy-matching dependency, refuse fuzzy matching from the standard library, and refuse any model field named score.",
      "evidence": [
        {
          "resource": "repo://backend/tests/unit/test_conformance.py#L149-L170",
          "version": "repo-lines-v1:sha256:9b7b1927ebb1ef26496fe65e02cbb14d066d6eb5b8237776a3a28af0d0d4f076:"
        }
      ]
    },
    {
      "id": "claim_7bef34e8eb84468b9bede3b35fa96820",
      "statement": "tok() mirrors Qdrant's WORD tokenizer rather than a project-specific regex, because verify reasons in Python about what the index matched and a one-token disagreement would make verify report present where the index found nothing — invisibly, since both halves are individually sensible.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/tok.py#L1-L17",
          "version": "repo-lines-v1:sha256:f402549dade39be2f0de3cb431e95f7f0024104d3ae81ffa567afa0b654bc8b0:"
        },
        {
          "resource": "repo://backend/vsir/core/tok.py#L36-L56",
          "version": "repo-lines-v1:sha256:35d73ffd4df1ffd916be1449db1ae1e05e0eb8a627e9767abf54533ec0894e17:"
        }
      ]
    },
    {
      "id": "claim_1b98433845ae4e4d8d6f44d6d458b61c",
      "statement": "The previous implementation's tokenisation behaviours are deliberately not ported: keeping a punctuated identifier as one token, and joining adjacent tokens — the latter would have made a two-token sequence matchable as a unit, a match this system must not be able to make.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/tok.py#L58-L64",
          "version": "repo-lines-v1:sha256:c674a6aa401f09ca77f91566f9f624caf88782f018d16424c156960aabdc7cb8:"
        },
        {
          "resource": "repo://backend/vsir/core/tok.py#L9-L17",
          "version": "repo-lines-v1:sha256:a9f36706790ff1a9516209b1dabb2c5bc14f829c3dd8fe68a3bf027f4653dd4d:"
        }
      ]
    },
    {
      "id": "claim_564adfbf15aa4efa8a75dd177c0a9f08",
      "statement": "contains_phrase and printed_in ask the identical exact-match question of a string in hand, using the same variants, the same tokeniser and a contiguous-run test, so derivation and the near-miss generator can check a code before a page is indexed at all.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/exact.py#L114-L152",
          "version": "repo-lines-v1:sha256:15e1005c55c07ed571580f64675a2d7ec1ce39550d7b2647cae2c1d98726cf05:"
        }
      ]
    },
    {
      "id": "claim_5681a6f7a81e4594b9acd7be78438cf1",
      "statement": "Verification is performed per (claim, page) pair and page_checks returns the whole matrix, because a draft citing two pages must not be able to borrow the neighbouring page's evidence; the matrix rather than the folded verdict is what the answer gate consumes.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/verify.py#L128-L147",
          "version": "repo-lines-v1:sha256:8358c8938b84d9a924beaf7d38b240ac9692617a79ae744a2ac926d7fd3aa3cb:"
        }
      ]
    },
    {
      "id": "claim_5b323719971041d186eaaf77fdb3df70",
      "statement": "A page is uncheckable when it is not current, has no text layer, or carries an untrusted extraction, and each of those yields unverifiable with a named reason rather than absent — because reporting absent about a page nobody could read converts the system's blind spot into the caller's confident denial.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/verify.py#L103-L125",
          "version": "repo-lines-v1:sha256:67b0ebc6181207ddc9ac9dd79133995a527cb506bfa2f1db34d0f16d58d5d5cc:"
        },
        {
          "resource": "repo://backend/vsir/core/verify.py#L40-L53",
          "version": "repo-lines-v1:sha256:af5b60f7702384e9f8853d1f0a3185054f551566407501f07b0c755b2b35b2f9:"
        }
      ]
    },
    {
      "id": "claim_4d65783412bf453abfab28176c3f99a7",
      "statement": "The fold gives present when any page carries the code and names only those pages; absent only when at least one page was actually checked, naming those pages and carrying present_instead; and unverifiable otherwise, with a shared reason or `mixed` where the pages disagree.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/verify.py#L150-L177",
          "version": "repo-lines-v1:sha256:fc12612188e64d59df38cbd910d9c6b071a816572b26f5e559f73c202b6e3670:"
        }
      ]
    },
    {
      "id": "claim_948de948c5f24d4d8391b597e60233b8",
      "statement": "A page_id absent from the collection raises PageNotFound and is answered as a 404 rather than any verdict, because an absent verdict about a nonexistent page would be a statement about nothing.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/verify.py#L56-L67",
          "version": "repo-lines-v1:sha256:5ce571bff75b777cf57f944ae53d0a6584fb67d46735fd0f2882d36ba0b410a0:"
        }
      ]
    },
    {
      "id": "claim_4fddf9fa56fd426dbc041e5773616d2d",
      "statement": "present_instead is a bounded prefix lookup rather than a distance: at most two characters are truncated from the claim, no prefix shorter than two characters is tried, at most five results are returned, the claim itself is excluded, and the disclosure is labelled \"different part\" rather than a suggested match.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/present_instead.py#L1-L30",
          "version": "repo-lines-v1:sha256:f4d1e7aa7981d4786c805ad293fc4de71d60a15b76a9eb417edf65031ab57292:"
        },
        {
          "resource": "repo://backend/vsir/core/present_instead.py#L34-L48",
          "version": "repo-lines-v1:sha256:6946c381364a79acfb851b40afbd56c327b2faff608496726fd340e649ff46e6:"
        }
      ]
    },
    {
      "id": "claim_8e3d0198a80944e7927ffd254d0fd0f8",
      "statement": "The observed-token inventory is unreachable from lookup by module boundary: serve/tools/lookup.py does not import core/observed_tokens.py and a test asserts its import graph never will, because a lookup able to consult the inventory could return a near miss as a hit.",
      "evidence": [
        {
          "resource": "repo://backend/tests/unit/test_lookup_pure.py#L400-L410",
          "version": "repo-lines-v1:sha256:b5ffebcd7d352fc03f14d554474898edd3f6c463c39a7b5287cdfb92c8322bcf:"
        },
        {
          "resource": "repo://backend/vsir/serve/tools/lookup.py#L34-L37",
          "version": "repo-lines-v1:sha256:22abe617cc89160ef4eb75f8884de70904c6ee1e608c5314a754528f938a3de6:"
        }
      ]
    },
    {
      "id": "claim_8a4b570582cc4ec69b4e780148fe3fa0",
      "statement": "The observed-token inventory is built from the extracted text field only — never from model-claimed codes — and only searchable pages contribute, so neither an unbacked model claim nor a garbled extraction's debris can be disclosed as what is present instead.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/observed_tokens.py#L1-L34",
          "version": "repo-lines-v1:sha256:17cc6f5338f3f3c26676491d660c48c983858b71ac506101be384a2d5ce65f5d:"
        }
      ]
    },
    {
      "id": "claim_d3a30e2241be4ac799988f250b18af13",
      "statement": "The code-like heuristic is deliberately crude — a token containing at least one digit — rather than an identifier grammar, because a miss costs a disclosure beside an already-absent verdict rather than an answer.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/observed_tokens.py#L47-L57",
          "version": "repo-lines-v1:sha256:f59cf5b4c3fe364cbd3c0e56201f5c86a1edbafce69fda08626708f6669f10d3:"
        }
      ]
    },
    {
      "id": "claim_10a4187449cf41989fe107a1c17fb7d9",
      "statement": "When no document-level inventory is supplied, verification builds a local inventory from the pages named in the call and returns none when those pages span more than one document, so a code from one binder cannot be disclosed as what is present instead on a page of another.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/verify.py#L179-L196",
          "version": "repo-lines-v1:sha256:93c33c0a840019fb4297122deafd1497ed0f42e8d7c7ee9e68b7867a7e611662:"
        }
      ]
    },
    {
      "id": "claim_36583f9094b84239af6ab447fe1cbdf5",
      "statement": "Near misses are generated by substituting exactly one character — never an insertion, deletion or transposition — deterministically with no RNG, and every candidate is excluded if any of its variants is printed anywhere in the corpus text, so a mutation that lands on a genuinely printed phrase is not mistaken for a near miss.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/nearmiss.py#L13-L31",
          "version": "repo-lines-v1:sha256:89c72ded4ccf7bf01b0af9129e52249512942783f29583057f6c8506e89b544a:"
        }
      ]
    }
