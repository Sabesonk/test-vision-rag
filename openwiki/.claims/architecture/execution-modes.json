        }
      ]
    },
    {
      "id": "claim_67ad2b91d3224251862776b40dc031ac",
      "statement": "Recording is a per-run flag rather than a configuration value, and the recorder never substitutes a body: every response comes from the wrapped backend verbatim and is frozen under the key the call was made with.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/record.py#L47-L60",
          "version": "repo-lines-v1:sha256:540193ead8a5232654baea2aaaba318e826d09c13051c580370a632e5cae82f4:"
