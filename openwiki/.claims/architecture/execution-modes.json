        }
      ]
    },
    {
      "id": "claim_ce53fe56d2b544c883d0c069fb1ca860",
      "statement": "Both the cache and the recorder wrap the VLM boundary rather than a pipeline step, so every call is caught by construction — including the extra calls a bisected window makes mid-flight, which a per-step wiring would miss.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/cached.py#L7-L13",
          "version": "repo-lines-v1:sha256:17cad8845bb7b9457fe0e85d17d3689e250f11457beda70b160f999e389788bc:"
