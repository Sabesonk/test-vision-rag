  "claims": [
    {
      "id": "claim_8ebd8c05dfbb41fabb1eb69bf662c2db",
      "statement": "VSIR_VLM selects the extraction backend and the embedding backend together through two parallel dict lookups (vsir.vlm.BACKENDS and vsir.ingest.embed.EMBEDDERS), so a run replaying extraction from a fixture cannot spend on embeddings and there is no second variable to set.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/embed.py#L663-L685",
          "version": "repo-lines-v1:sha256:baa227062479942f8840faac40f1693e17d66fc9028a4fedf4aa9415375717ae:"
        },
        {
          "resource": "repo://backend/vsir/vlm/__init__.py#L64-L75",
          "version": "repo-lines-v1:sha256:5af6827840827567c417b3e24f837b927965950c343dc5e9de94d657235194d4:"
        }
      ]
    },
    {
      "id": "claim_0bb047cf46754e45890d2267d657c1d8",
      "statement": "Both the stub and the live backends are imported unconditionally into the image and selected at boot from configuration, and a VSIR_VLM value the table does not know raises a typed vlm_backend_unavailable naming the available backends rather than a KeyError.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/embed.py#L674-L684",
          "version": "repo-lines-v1:sha256:3ddb8fa69649561df2a15dbb506555479159bf55ec461e82718af58dec380e7e:"
        },
        {
          "resource": "repo://backend/vsir/vlm/__init__.py#L87-L97",
          "version": "repo-lines-v1:sha256:a6c4b6ccdd93f01abca7829d66a5320561719e82858c4d7a3ac312989339a288:"
        }
      ]
    },
    {
      "id": "claim_3f183845bbc140328d5a6c7faa10e908",
      "statement": "A conformance grep over the whole vsir package fails the build on any test-only branch (if TESTING, TESTING environment reads, PYTEST_CURRENT_TEST, or a pytest membership test), so the code path under test is the code path that ships.",
      "evidence": [
        {
          "resource": "repo://backend/tests/unit/test_conformance.py#L310-L321",
          "version": "repo-lines-v1:sha256:8eca458f216e393acd5ac311b5bf8e25a96d1fa2ca4f68e0ad1f4bf38e852721:"
        }
      ]
    },
    {
      "id": "claim_ddc2c6f71d7d4ca5b3c5f9ce1d317bdf",
      "statement": "The four cache keys are sha256 digests over exactly the inputs that can change an answer: facts_key over content hash, model id and prompt version; extract_key over ordered page image hashes, model id, prompt version, dpi and schema hash; read_key over the extract_key inputs plus the question; and embed_key over composition version, embed model id and the composed string.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/cache.py#L147-L201",
          "version": "repo-lines-v1:sha256:6bc6711494848ea571b98ae0e8af71ad9403e2f73e658488114ccefe67737eed:"
        }
      ]
    },
    {
      "id": "claim_866f60110caf4db59edd225c0789ea53",
      "statement": "Cache key inputs are length-prefixed before joining, because a plain separator would let two different input splits collide on one key and serve one configuration's output as another's — and one of the inputs, prompt_version, is operator-supplied.",
      "evidence": [
        {
          "resource": "repo://backend/tests/unit/test_cache_keys.py#L197-L209",
          "version": "repo-lines-v1:sha256:40872aec823417bf96ab5724c0c3c19168337b21287980dd787b50830b92159b:"
        },
        {
          "resource": "repo://backend/vsir/vlm/cache.py#L74-L82",
          "version": "repo-lines-v1:sha256:b012e04ff7b71b0872466f1ff8cf0d6036ea99da8c19de8af51e176ae7a32cc7:"
        }
      ]
    },
    {
      "id": "claim_2bd2f502677343b3af005a347987159f",
      "statement": "extract_key hashes the ordered page image hashes rather than a file hash plus a plan hash, so the key depends on the pixels the model will actually see and two windows of the same document cannot collide.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/cache.py#L159-L169",
          "version": "repo-lines-v1:sha256:28b50ccd5aaee6dc2c231db8eaa120c5a27c72c8377a369ec310542b8979a835:"
        }
      ]
    },
    {
      "id": "claim_6ef08c785ff64c1e94d810689ea71425",
      "statement": "read_key includes the question, which is why the read tool pins dpi server-side: a caller-controlled dpi would be a cache-key input the caller could vary, billing the same question once per dpi.",
      "evidence": [
        {
          "resource": "repo://backend/tests/unit/test_cache_keys.py#L133-L158",
          "version": "repo-lines-v1:sha256:04f7e43bc062286fdf6233027051d13c486b5249891be9c0ac57d832e1642259:"
        },
        {
          "resource": "repo://backend/vsir/vlm/cache.py#L171-L185",
          "version": "repo-lines-v1:sha256:55a6636d6237a0881ea727fcf9278aa2155ba2aea4a22ae3953019d468b1b439:"
        }
      ]
    },
    {
      "id": "claim_6409900e26da4e8880279f2067328058",
      "statement": "VSIR_VLM_TIER is deliberately not an input to any cache key, because batch and standard produce the same output and keying on the tier would re-bill a whole corpus for taking the discount.",
      "evidence": [
        {
          "resource": "repo://backend/tests/unit/test_cache_keys.py#L113-L122",
          "version": "repo-lines-v1:sha256:3a72691a4d2a8320e819ab8142f18bb1cb4848b26c9008947a6e3fce34f4e824:"
        },
        {
          "resource": "repo://backend/vsir/vlm/cache.py#L37-L40",
          "version": "repo-lines-v1:sha256:fd95e6f2f422b618d89a7b87d13377d0837a9760d622d578778b88a635717c57:"
        }
      ]
    },
    {
      "id": "claim_6f9f21f1ba244abfba440eb196c7a1a2",
      "statement": "embed_key deliberately has no dim input, because a dimension change is a change of collection rather than of namespace; the collection fingerprint guards that instead.",
      "evidence": [
        {
          "resource": "repo://backend/tests/unit/test_cache_keys.py#L184-L189",
          "version": "repo-lines-v1:sha256:51f432604d53cea5d57b8073bbbedacf0d860d61f466804b13d438c83774cdb0:"
        },
        {
          "resource": "repo://backend/vsir/vlm/cache.py#L187-L201",
          "version": "repo-lines-v1:sha256:f6a44791043551780a1ad872890abdd459db82c2f9b14923860c0c1642d3c977:"
        }
      ]
    },
    {
      "id": "claim_e4c321fa8d664f6091c0c8192b6e86a0",
      "statement": "Frozen responses live under three namespaces — facts, extract and read, one per call rather than per model — and the namespace is encoded into the derived control-plane point id so two different calls cannot collide even if their keys did.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/cache.py#L317-L330",
          "version": "repo-lines-v1:sha256:e838615497754c35a83bbf3c532e4f9befb8bca7725f443464833aeec012bc2a:"
