        }
      ]
    },
    {
      "id": "claim_67a9d97f3638462db45421d4288ab1d1",
      "statement": "VSIR_ALLOW_PAID is read in exactly one application code path — check_spend_allowed at the document upload boundary — where a live-configured release without it is refused 403 spend_not_permitted, while a stub-configured release takes uploads with no switch at all.",
