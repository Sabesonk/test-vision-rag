    },
    {
      "id": "claim_0c9397a496174a53bae742d2dfb559aa",
      "statement": "The model-id pin is re-verified at the point of spend, outside the retry ladder, because a long-lived worker's configuration may never have passed a boot check and a repointed floating alias would leave the cache key unchanged while the model behind it changed.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/client.py#L352-L370",
          "version": "repo-lines-v1:sha256:ac607176b973f49a477b49b9461dccf7442d1e1d7330a457a8e4aad99a14ee67:"
