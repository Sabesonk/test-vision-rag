    },
    {
      "id": "claim_29b5342fdedb48a8934d519a0c4aa9dc",
      "statement": "Prompts are part of the release rather than configuration: prompt() refuses a version absent from PROMPT_DIGESTS, and replay never reaches it at all because the prompt version lives in the cache key — which is how fixtures frozen under an older prompt version keep replaying.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/client.py#L173-L195",
          "version": "repo-lines-v1:sha256:157d7955d0b94562cf02e05a623cd1bc5f31e7d22d3f4f9fd6da0d41b9430c62:"
