    },
    {
      "id": "claim_42c940c1af96462bba3a751677d23c2a",
      "statement": "The live client's retryable set includes httpx transport failures as well as HTTP statuses, because a connection that never produced a reply cannot have been rejected on its merits — a gap that previously threw away runs after the extraction spend had already been paid.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/client.py#L104-L131",
          "version": "repo-lines-v1:sha256:6e64c458a750586bed053480b4b4a2bd3dcba78e028f66c281617df0d6ddc415:"
        }
      ]
    },
    {
      "id": "claim_daf739eef55f480981e7e010f9546d29",
      "statement": "CachingBackend reads the durable control-plane store before calling the wrapped backend and writes the response back afterwards, and it wraps the stub as well as the live backend so the resume path it exists for is exercised by the free test layers.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/cached.py#L1-L31",
          "version": "repo-lines-v1:sha256:7fbef783e60a621bb1302e505811b194c77fec516366fee5381ebe2813f92781:"
