        }
      ]
    },
    {
      "id": "claim_311bd609505d4510a64389f51036b283",
      "statement": "A cache write failure is swallowed and logged while a read failure raises, so an unavailable store costs the next run a re-bill rather than turning an outage into unmetered spending.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/cached.py#L28-L31",
          "version": "repo-lines-v1:sha256:12a1d1b9baa26bec44ffe6bb295478b10e6136fe8776166042ea5bc40b1b7c4e:"
        },
        {
