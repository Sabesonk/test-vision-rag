        }
      ]
    },
    {
      "id": "claim_423ce574ea6249dfba338204bbe8a3ba",
      "statement": "FixtureStore is read-only and addresses a response by its key alone with no revision, run id or document id in the path; the only writer into a fixture directory is the module-level write() function, kept off the store so a running process cannot fill its own cache.",
      "evidence": [
        {
          "resource": "repo://backend/tests/unit/test_cache_keys.py#L252-L257",
          "version": "repo-lines-v1:sha256:df465ca51e6e6ea25b0f3ec67a94ad3165d53c63320de3af5f61f423032aa72b:"
