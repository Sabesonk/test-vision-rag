    },
    {
      "id": "claim_890c9396026c4b98bd3bd2b5ed08c685",
      "statement": "The live Gemini backend refuses to be constructed without VSIR_VLM_KEY, and holds the credential in a repr=False field so no traceback or log line can carry it.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/client.py#L315-L350",
          "version": "repo-lines-v1:sha256:de8ad3c9d4a7774247fc4a78a13c0f15f8b83f394bda1c40e4f0da736704a9f3:"
        }
