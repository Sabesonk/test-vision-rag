    },
    {
      "id": "claim_04685806e9944cb2b040db0b98d31c23",
      "statement": "VSIR_VLM=stub with no VSIR_FIXTURE, or with a path that is not a directory, is a named vlm_backend_unavailable refusal at backend construction rather than a skip.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/stub.py#L44-L66",
          "version": "repo-lines-v1:sha256:dac7f4a78049cfce518fd81a7d3eb3f939347a0693839dfdb1d407965292740f:"
        }
      ]
    },
    {
      "id": "claim_378c6b5dc3ba47e0bf7c55630a87b8a4",
      "statement": "The stub reproduces a provider-side truncation as a truncation: when a frozen response's sidecar records a non-STOP finish reason the stub raises VlmTruncated, so the bisect-and-re-bill repair path is exercised by the replay corpus rather than only by a paid run.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/stub.py#L73-L85",
          "version": "repo-lines-v1:sha256:4d84b31d24c2805e8886c891620d9d2998c42e4cdd93c987af6973b52220c434:"
        }
