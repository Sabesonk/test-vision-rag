    {
      "id": "claim_70ac874573134636ad86a98c4f65c426",
      "statement": "A cache entry keeps the verbatim response body plus finish_reason and usage rather than a processed record, so a downstream change can be re-derived without buying the paid call again.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/cache.py#L203-L233",
          "version": "repo-lines-v1:sha256:a9956bec756e8550a748300c48fcd385ba88223b28c25c0cfcce2ab682cf7a11:"
        }
      ]
    },
    {
      "id": "claim_14bd70a38ae04855b326e952b8a2c282",
      "statement": "The stub backend never falls back to a live call and never fabricates a body: a key absent from the fixture directory raises a typed FixtureMiss naming the namespace, the key and the directory.",
