        }
      ]
    },
    {
      "id": "claim_427e7874c7964c0bafa93f2204f848b7",
      "statement": "StubEmbedder computes a deterministic vector from the composition instead of replaying a frozen one, which lets tests assert both that an unchanged composition re-embeds identically and that a changed composition produces a different vector.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/embed.py#L373-L396",
          "version": "repo-lines-v1:sha256:e8e1caebb48f03d54b44e9cdad10ec344dd3f7522b0f46ed49250e334a72def8:"
        }
      ]
