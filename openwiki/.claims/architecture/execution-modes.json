        }
      ]
    },
    {
      "id": "claim_61f7ab0ac7644b30bc4ce9c20e4a3113",
      "statement": "A VSIR_VLM_TIER other than standard raises vlm_tier_unsupported before any call is made, and the refusal notes that a run started on standard can be finished on batch without re-billing because the tier is not a key input.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/vlm/client.py#L352-L362",
          "version": "repo-lines-v1:sha256:903529c6d8abe1762dbd94d8ec7b14e42b6ad2f47b3a43678e968232707a3d3d:"
        }
