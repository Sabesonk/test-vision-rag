          "version": "repo-lines-v1:sha256:f93f7c9befec47e7629e2d3143eb64791b69bbce4562162af52d8911a241b1fe:"
        }
      ]
    },
    {
      "id": "claim_629fb057b0124e8c92c964397039c2ad",
      "statement": "dispatch() is the single entry point for every transport: it resolves the tool name against the release's table, validates arguments against that tool's own Pydantic model with extra=forbid, and then calls run_tool — so HTTP, MCP and the CLI share one validator and one implementation.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/app.py#L1130-L1169",
          "version": "repo-lines-v1:sha256:5a73f2bb00c868e9dafc7df4388484589e1654d116e52a178b90a97ebb04f69b:"
        }
      ]
    },
    {
      "id": "claim_27cffc5cd2b041e785c1f8a71b2273f5",
      "statement": "A tool name absent from the table is a typed 404 listing the tools that are served, rather than an empty result or an unimplemented-shaped silence.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/app.py#L1148-L1157",
          "version": "repo-lines-v1:sha256:40d0235583502ae6b75f88e610a0a8f5770c29d06e6c7cf74986299004f44c35:"
        }
      ]
    },
    {
      "id": "claim_29f36b225f3549038ca40fe7c930515f",
      "statement": "run_tool applies the cross-cutting policy in a fixed order — request-only precheck, budget charge for the one spending tool, the call, reads_remaining stamped by the dispatcher, then the audit line — so no tool can carry its own idea of budgeting or of which failures are which.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/app.py#L1076-L1128",
          "version": "repo-lines-v1:sha256:237d3132f1f2188ee855250efea42baf8c4fcc67a9d9a4ff462ea1697670499d:"
        }
      ]
    },
    {
      "id": "claim_71c286113169499e8e4fe65ffae67069",
      "statement": "The CLI is the supported operational surface by design: each command of the operations table is a subparser, an action that cannot be expressed as a vsir subcommand is not a supported operation, and a refusal is a non-zero exit with a named reason rather than a partial success.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/cli.py#L1-L11",
          "version": "repo-lines-v1:sha256:bae0b0d2ce686c9490fa692906dbe73c438486edb99c8863b21918f0f363ef4c:"
