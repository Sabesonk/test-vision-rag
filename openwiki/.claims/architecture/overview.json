  "claims": [
    {
      "id": "claim_471e0862cd624ad6b337ccf1b4138942",
      "statement": "The addressable retrieval unit is the page and there is no chunk anywhere in the system: a window is a page range created only by the model's attention limit, deleted again by stitching, and never a retrieval boundary.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/app.py#L849-L856",
          "version": "repo-lines-v1:sha256:361a36f5599a507a353823bb99fb8421d220a7c82ee56566506468e5c2ab0658:"
        },
        {
          "resource": "repo://backend/vsir/serve/manage.py#L28-L36",
          "version": "repo-lines-v1:sha256:e46c3c362273465015989be17c15516afcd3a49baa3d4e1a0c9464a7b5c29847:"
        }
      ]
    },
    {
      "id": "claim_f505eab84927402db1a7503edcce8d8f",
      "statement": "The ingest pipeline is eleven named ordered steps (manifest, probe, render, facts, window, extract, derive, stitch, embed, index, publish) driven by one CLI command, and exactly three of them — embed, index and publish — require a reachable Qdrant, so with no store they refuse rather than re-billing vectors the index already holds.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/cli.py#L589-L601",
          "version": "repo-lines-v1:sha256:e5ef97aa773e74b86e6020f1b8b703612f2217a2417bb268c61956efaa02ed60:"
        }
      ]
    },
    {
      "id": "claim_9a18172830384815b29e654ee47aea3f",
      "statement": "Step 10 writes one Qdrant point per page carrying three surfaces — the fused dense vector, a lexical sparse surface over extracted text, and a captions sparse surface over the model's summaries and topics.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/indexed.py#L47-L52",
          "version": "repo-lines-v1:sha256:b3fd7a234d6a2714498051598f7038006dfe342830e109fc891b1eb0d9e80990:"
        },
        {
          "resource": "repo://backend/vsir/ingest/index.py#L1-L8",
          "version": "repo-lines-v1:sha256:542384ce47e7e26a6328687aab0fad98d488f91a2517bf99928b70d5a6fb879c:"
        }
      ]
    },
    {
      "id": "claim_2b0d2927acfd41ac9e2d22418808f9db",
      "statement": "Every page point is written with is_current false and only the publish step flips it, and the index module refuses a record that arrives already claiming otherwise, so a run that has not passed its gates cannot answer.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/index.py#L27-L30",
          "version": "repo-lines-v1:sha256:ab2443ab77287dc92112326a20b1540fd86307b2124735cbbd9ffb2875a30ab5:"
        }
      ]
    },
    {
      "id": "claim_e6d11e90596b46c68f2c2ed679cd6768",
      "statement": "The collection fingerprint is checked as the first action of an upsert rather than only at boot, so a mismatch writes zero points — because a long-lived ingest worker can hold a configuration that never passed a boot check.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/index.py#L35-L38",
          "version": "repo-lines-v1:sha256:6ea046aa3a979a7672bd50ac0a979c6dec04a02c5d97238ec1d81700aa5b91ba:"
        }
      ]
    },
    {
      "id": "claim_ad5e29c8af394190a12875e46cc96cbd",
      "statement": "No page payload may name a file on disk: index.py refuses the payload keys image_path, image_url and render_path at the write, because rasters are re-rendered on demand rather than stored.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/index.py#L31-L34",
          "version": "repo-lines-v1:sha256:79898d42baeaeb636c58957900daf2e9aa4e260c75b44c4c6e045eebb63e5deb:"
        },
        {
          "resource": "repo://backend/vsir/ingest/index.py#L62-L68",
          "version": "repo-lines-v1:sha256:0ad8d02cf5628e2f8c6d9943aec2c9baa52440a495c9548333fe43091d96f036:"
        }
      ]
    },
    {
      "id": "claim_e1bd81728d774ccb92a784a2b7a5d850",
      "statement": "The pages collection is itself the embedding cache: the index module reads the vector and embed_key already stored on a page's point so an unchanged page is not re-embedded, which closes the caching need without adding state anywhere else.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/index.py#L40-L44",
          "version": "repo-lines-v1:sha256:4f82559e218f2f503cce28298d361a9207c4e67ce9f97c948364eb21732fc68d:"
        }
      ]
    },
    {
      "id": "claim_619dce61ec8344b68bb80195a7c1972c",
      "statement": "A single module-level INDEXED dict creates the payload indexes, gates every caller filter, and is asserted against the live collection at boot; a filter on a field absent from it is a typed 400 rather than an unindexed scan that would silently return a smaller answer.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/indexed.py#L1-L19",
          "version": "repo-lines-v1:sha256:011376e0d7720c1b34f85729ed567648282aba6ee5bd3c391bb1a248a7e6c07b:"
        },
        {
          "resource": "repo://backend/vsir/core/indexed.py#L30-L45",
          "version": "repo-lines-v1:sha256:57c4501174cbbb170cbafd46c7b49fb8735fa5f98002cf8c3b6f7bc0b9ba897a:"
        }
      ]
    },
    {
      "id": "claim_89d8abdcb266470ab9d319d0cb2b5c98",
      "statement": "The two text surfaces text and vlm_codes are indexed with phrase matching and a minimum token length of one, which turns a printed identifier such as \"SF 1.1A\" into an ordered phrase instead of a bag of common tokens.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/indexed.py#L46-L47",
          "version": "repo-lines-v1:sha256:be6bc58f48968fe8a367dd77b31b1adebe41cd54d011ccaf31c084357b178afb:"
        },
