  "claims": [
    {
      "id": "claim_a54d78199cfd49aaa3060a0df87c31e7",
      "statement": "The pages collection declares one cosine dense vector plus two sparse vectors, and both sparse surfaces carry Qdrant's IDF modifier so only BM25's term-frequency half is stored and the IDF half is computed at query time — which is what stops a newly ingested document from staling every vector already in the index.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/indexed.py#L85-L95",
          "version": "repo-lines-v1:sha256:86b2c31305996a29edb69bb86fe004bcd7f1f84b31a198687042623905cd7800:"
        }
      ]
    },
    {
      "id": "claim_8bbbc53b454048c3858fb50a6114f0a9",
      "statement": "create_collection creates every payload index before the first point is written, because filterable HNSW builds extra graph edges from indexed payload values as points arrive and indexing afterwards silently leaves the filter answering from a worse graph.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/core/indexed.py#L97-L121",
          "version": "repo-lines-v1:sha256:0ad2871ae7afb3c90e5a0eb5ee35c5b5050dde2fe498a1a9a303639c944a73ed:"
        }
      ]
    },
    {
      "id": "claim_e410e86634b74b20a553a105d65cb6bf",
      "statement": "The control plane collection is created payload-only with vectors_config={}, because every control record is fetched by id or exact filter and nothing in it is searched by similarity.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/fingerprint.py#L150-L166",
          "version": "repo-lines-v1:sha256:3379169bc6ff2ad72ce6a27203361a2927ea8ce8cae51d15465106df6ba93238:"
        }
      ]
    },
    {
      "id": "claim_fc41ae87fe2943ecb8baa9030e86e6cd",
      "statement": "Every point in the control plane carries a kind discriminator, and the release uses six: run, window, observed_tokens, fingerprint, budget and vlm_cache.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/fingerprint.py#L60-L64",
          "version": "repo-lines-v1:sha256:fa8bf6d092fd668b9d8262a581582f349a411f1954baf5bd3265859514c6e36e:"
        },
        {
          "resource": "repo://backend/vsir/ingest/run.py#L68-L71",
          "version": "repo-lines-v1:sha256:2ffc6f29ed15887853db6f9c3683e4c71c4e6d00fbd5f25dfbe53474201f87ca:"
        },
        {
          "resource": "repo://backend/vsir/serve/budget.py#L45-L47",
          "version": "repo-lines-v1:sha256:8ddf7120267131229e530c433b43b8c8575f9577a31c29d9c4eb673bd3a6bf94:"
        },
        {
          "resource": "repo://backend/vsir/vlm/cache.py#L310-L315",
          "version": "repo-lines-v1:sha256:021c96ceae5a00e154b208de32453952c18129898fbcbbba4266710f2328356a:"
        }
      ]
    },
    {
      "id": "claim_1d7d4efa36434ff9a579613c413fa231",
      "statement": "ensure_control_plane reads the live payload schema before creating the run_id, doc_id, revision and state indexes, so an index that already exists is not re-created on every run and a collection created by an earlier release still gains the missing ones.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/run.py#L360-L374",
          "version": "repo-lines-v1:sha256:ea5d8cdc0090e567b6cc359e5a6c1e3195c253357becd275277237f8c9ea642f:"
        },
        {
          "resource": "repo://backend/vsir/ingest/run.py#L99-L104",
          "version": "repo-lines-v1:sha256:e175ecd1e17d9de727e05a13d2e764ddb969e1faad96deccca274881ea55908e:"
        }
      ]
    },
    {
      "id": "claim_f5e64ad5735a43b084b6037079a96439",
      "statement": "Control-plane writes are retried only when they are idempotent — a filtered set_payload with a constant value, a filtered delete, a keyed upsert — and when the bounded retries are exhausted the run reports itself unpublished rather than half-published, because published_at is written only after the flip returns.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/run.py#L377-L400",
          "version": "repo-lines-v1:sha256:a048a1c3cc1f31ffa44af57481e8a667490f613ad151c81367b172686e4811f1:"
        }
      ]
    },
    {
      "id": "claim_804e4f31a9894e30b11691c80ce0633b",
      "statement": "The document store holds source PDFs rather than derived artefacts, which is what lets the no-persisted-raster rule stand: rasters are still re-rendered on demand, and now have a file to be re-rendered from.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/store.py#L1-L19",
          "version": "repo-lines-v1:sha256:010f595560995734dc4d44979c7c737620934bfa6c40443be5b594cd4ea95a73:"
        }
      ]
    },
    {
      "id": "claim_d5fedb03fe2747209f67cf4a1b045ef0",
      "statement": "A document is stored identity-addressed as <doc_id>@<revision>.pdf so no path is ever written into a page payload; the content hash lives on the run record instead, and locate() refuses bytes that disagree with the hash the caller expects.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/store.py#L21-L30",
          "version": "repo-lines-v1:sha256:d2262b33f7f45502a92539dfe091f18da05a4b7588d37117a306332c25835b9e:"
        }
      ]
    },
    {
      "id": "claim_423eab28633d4ab4a6be220ed5f365ac",
      "statement": "Document id and revision are validated against a conservative component pattern before they reach a filesystem path, because a page_id can arrive from a caller's saved citation and an unchecked revision would be a path traversal carried by a citation.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/store.py#L76-L81",
          "version": "repo-lines-v1:sha256:e1803a2ba1d603614dfcda472a8803bacc4a4cf5a906b49c8935b96ecc1f8234:"
        }
      ]
    },
    {
      "id": "claim_565215b9eec4454b801d41f5c9bedab6",
      "statement": "The document store writes through a dot-prefixed staging directory inside its own root so the final rename stays on one filesystem and is atomic.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/store.py#L73-L75",
          "version": "repo-lines-v1:sha256:ba16dbad3063493ff740c7befbf0abee80d64da98699b0673f2e960c19bf558f:"
        }
      ]
    },
    {
      "id": "claim_2cad35af81ca4bc199a34d88f0e29a07",
      "statement": "VSIR_DOC_STORE is deliberately not one of the required environment variables and defaults to a directory under the platform temporary directory, so a release that never ingests and never serves an image is not made unstartable by it.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/store.py#L58-L67",
          "version": "repo-lines-v1:sha256:6cb10d951fe320c42492662fcb4d8749ae5046700c0d87c4b6b2c379171e5b37:"
        }
      ]
    },
    {
      "id": "claim_320aafeca4c846cda67cec0cfafa8cc8",
      "statement": "There is exactly one raster cache in the system — render._cached, shared by the ingest and serving paths and keyed by the source file's content hash — and the serving layer deliberately adds no second cache keyed by page_id, which could not see a re-ingest from corrected bytes and would serve superseded pixels for the life of the process.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/render.py#L165-L179",
          "version": "repo-lines-v1:sha256:f91efdf52636708bd4e3fd590bfa12c1e52f4698bd3fab8dd62e70a183ddf10e:"
        },
        {
          "resource": "repo://backend/vsir/serve/raster_cache.py#L9-L16",
          "version": "repo-lines-v1:sha256:0ea939e93073e939d43c0914488f0afff7a9c773e3ea7bc556c666fc892b6705:"
        }
      ]
    },
    {
      "id": "claim_9ae86e669ab24d2393b304f129021542",
      "statement": "Page rectangles get their own far larger memo separate from the raster cache, because a page box is four floats while a raster is megabytes and the box is what decides whether the raster may be made at all.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/render.py#L182-L192",
          "version": "repo-lines-v1:sha256:218931e5981ad539946121290c6c7bf942ca65566524a1c189f5554013f2202a:"
        }
      ]
    },
    {
      "id": "claim_7c62c67270bd4bfd8c32c4204982f199",
      "statement": "The serving layer owns the raster request policy the renderer must not know: percent-encoding the page_id's # in one place, resolving page_id through the indexed page and its run to stored bytes, passing the run record's content_hash as an integrity expectation, and checking the megapixel ceiling from a prediction before the render allocates.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/raster_cache.py#L17-L40",
          "version": "repo-lines-v1:sha256:751ff28d221a5486c4eb51e2661887ba1f463989bd2b35b03239a44265a32ff3:"
        }
      ]
    },
    {
      "id": "claim_ecf17eeeac4d41519ed0254cbde45d1e",
      "statement": "Raster resolution keeps three failures distinct because callers retry them differently: an unknown page is a 404, a page that is not the current revision is its own 404, and a page whose source document is missing from the store is a 503.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/ingest/store.py#L31-L34",
          "version": "repo-lines-v1:sha256:062353d7f9790356bb5f2f5b9d3135e35940bea25d95baff52455c58333b9d63:"
        },
        {
          "resource": "repo://backend/vsir/serve/raster_cache.py#L26-L31",
          "version": "repo-lines-v1:sha256:bca43e044bafb6f1becad0906ca3480e110f385855890069115cadcb32b9471a:"
        }
      ]
    },
    {
      "id": "claim_aa08e593de0744d6977e09fd12e481fe",
      "statement": "The upload spool is a transport buffer removed when the ingest child exits however it exits; what makes an uploaded run resumable after its accepting instance is gone is the document store, not the spool.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/serve/ingest.py#L19-L32",
          "version": "repo-lines-v1:sha256:f7bf3fa69161caa20c830e2a5b89ea66b7b4a361c41383a2aa470f7590a9a636:"
        },
        {
          "resource": "repo://backend/vsir/serve/ingest.py#L74-L78",
          "version": "repo-lines-v1:sha256:8ea00c84b223fa407c79545590e1b6f6bdbb12d9940412c39d89185b7a6591bb:"
        }
      ]
    }
