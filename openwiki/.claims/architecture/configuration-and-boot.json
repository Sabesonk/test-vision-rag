  "claims": [
    {
      "id": "claim_4fe8e1e1dba7420aaac295d5415cd4f6",
      "statement": "Configuration reaches a VSIR process only through the environment: load_config reads a mapping (os.environ by default) and returns a frozen Config dataclass, and no module reads the .env file, which is an example a developer sources into a shell.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/config.py#L108-L112",
          "version": "repo-lines-v1:sha256:0e0a6db18c5ddc48352a80eafdd9aa255669e45d053d0aff0f3c642dcd191fe6:"
        },
        {
          "resource": "repo://backend/vsir/config.py#L272-L322",
          "version": "repo-lines-v1:sha256:8c47be139c19f562f0e91ed5d776b4ec60141c2763748a0354096b7db17ff180:"
        }
      ]
    },
    {
      "id": "claim_26d11a5267234ed198f56c7c0fff740a",
      "statement": "Values that do not vary by deployment — the two raster dpi values, embedding parameters, the fusion surface weights and RRF constant, page caps, the BM25 constants, COMPOSITION_VERSION and SPARSE_VERSION — are module constants in config.py and are not readable from the environment.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/config.py#L26-L62",
          "version": "repo-lines-v1:sha256:7051722c819bb87730ce05ac2d78fd0cf036d8d5c5f7784f4efff9ad976f01bc:"
        }
      ]
    },
    {
      "id": "claim_9cea408c0e2444c7b7e333dbf7a79483",
      "statement": "The twelve variables in REQUIRED_ENV have no fallback: an unset or blank value raises MissingConfig naming the variable, and an out-of-range or unparseable value raises InvalidConfig naming the variable and the reason, so no configured value is ever silently coerced to a default.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/config.py#L228-L270",
          "version": "repo-lines-v1:sha256:03fefdc3e07c6bb79e3573b5c1d89034ecfa36a390543bc2601377b3a423a847:"
        },
        {
          "resource": "repo://backend/vsir/config.py#L272-L322",
          "version": "repo-lines-v1:sha256:8c47be139c19f562f0e91ed5d776b4ec60141c2763748a0354096b7db17ff180:"
        },
        {
          "resource": "repo://backend/vsir/config.py#L64-L77",
          "version": "repo-lines-v1:sha256:7a139e2b96dc3e7fcbf3aeaf2d2a75edf50489df20dd1cb3a22620a011c27ce2:"
        }
      ]
    },
    {
      "id": "claim_9254bf17740d4a93ae716764be8d49f2",
      "statement": "The embedding dimension is part of the served collection name — pages_collection is `{VSIR_COLLECTION}_{VSIR_EMBED_DIM}` — so two dimensions are two separate collections rather than two named vectors inside one.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/config.py#L146-L150",
          "version": "repo-lines-v1:sha256:5880c622beffc02433f32669dfa991d3964a65d9f4677e3c29ae3953f0897a25:"
        }
      ]
    },
    {
      "id": "claim_4aae59fcde1d4ac999a57f9b156810e8",
      "statement": "Config.fingerprint is the five-field recipe a collection's vectors were made under (embed_model, dim, distance, composition_version, sparse_version), and fingerprint_id is a sha256 digest of its canonical JSON form.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/config.py#L151-L176",
          "version": "repo-lines-v1:sha256:83c21e0057322f73244fb5d937058a3d3ff55c10fa72f390c39f601421b1f38c:"
        }
      ]
    },
    {
      "id": "claim_6af804cc70bd4d0f820f7e078f579b9b",
      "statement": "Replay mode is a derived property of configuration alone — Config.replay is exactly `vlm == \"stub\" and bool(fixture_dir)` — rather than a code branch or a test-only flag.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/config.py#L180-L183",
          "version": "repo-lines-v1:sha256:ba0d852822822eb1cd02d24c23bcb6a2ecf3ee86926b107f5c3b09434379a653:"
        }
      ]
    },
    {
      "id": "claim_39456142f6c646d0b67ed29fba3c058d",
      "statement": "Credentials cannot reach a log line by accident: api_tokens and vlm_key are declared repr=False on the frozen dataclass, Config.redacted() reports them only as a token count and a presence boolean, and scrub_url strips userinfo from the Qdrant URL.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/config.py#L142-L145",
          "version": "repo-lines-v1:sha256:52605e83fb611d42e1d3f4e183c24a2535be51ccdb80a64a9e5bd1e485aebf47:"
        },
        {
          "resource": "repo://backend/vsir/config.py#L184-L215",
          "version": "repo-lines-v1:sha256:6dfb7e6b3b16225fde0fa6eb95e7caa5186226a4b708bd905caf8f41e90627a6:"
        },
        {
          "resource": "repo://backend/vsir/config.py#L217-L228",
          "version": "repo-lines-v1:sha256:2fcf993105f4519521c8f16d363be5ec6c2d6aae35ec2e978dedaeee074b2e80:"
        }
      ]
    },
    {
      "id": "claim_73b41ff8ad8f4c08b4d9e238de814b57",
      "statement": "The logging layer redacts on field name rather than value, blanking any field whose name contains token, secret, password, authorization, credential or bearer plus the exact names key, vlm_key and auth, so a new call site cannot leak a credential by forgetting to redact.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/logging.py#L27-L31",
          "version": "repo-lines-v1:sha256:8c45b2c53a32a15bc799e2c899e8af80b5561ef2c660d7d2bcdd59df19e8c6a0:"
        },
        {
          "resource": "repo://backend/vsir/logging.py#L66-L70",
          "version": "repo-lines-v1:sha256:40edc9e6cfce9b6f94b32b8bfa6cf66b2ecbc4f9a2a599dd37c8efd2cbd584ac:"
        }
      ]
    },
    {
      "id": "claim_d1ce6a13fefa43ce932f72d9c90b4be4",
      "statement": "`vsir doctor` and server start run the identical ordered BOOT_CHECKS tuple, so a configuration the CLI refuses cannot be one the server accepts; the CLI turns failures into an exit code and the server raises BootRefused before a port is bound.",
      "evidence": [
        {
          "resource": "repo://backend/vsir/doctor.py#L337-L347",
          "version": "repo-lines-v1:sha256:315ff024cbd14c81e38c259013145823f32a7253a35e1a70b0e9c9a3d0cd25eb:"
        },
