          "version": "repo-lines-v1:sha256:1058c5fc6f251d2ad4c33eeb23b68c5cc88f147f3aa1bf940c7db4f879710c03:"
        },
        {
          "resource": "repo://backend/vsir/serve/app.py#L1186-L1191",
          "version": "repo-lines-v1:sha256:47e3610017596f65c61c4dd1491ce73bd1dee408995ebbf8376ae788b0a26c27:"
        }
      ]
    },
    {
      "id": "claim_dea30d2b82714b6b8e15ddafe53f802e",
      "statement": "run_boot_checks executes every check even after one fails, so a refusal reports all failing checks rather than stopping at the first.",
